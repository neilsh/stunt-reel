# Stored LF everywhere; Windows launchers stay CRLF so cmd.exe keeps parsing them.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Markdown keeps trailing spaces (hard breaks, .editorconfig), so `git diff --check` does not
# count them as whitespace errors. The pre-commit hook's trailing-whitespace built-in allows
# exactly two (prek.toml).
*.md whitespace=-blank-at-eol
*.png binary
*.mp4 binary
*.idx binary
*.layer binary
*.zst binary
*.jpg binary
*.zip binary
*.glb binary
# The generated expected-scores files take main's side on a merge or rebase (ADR 0053); the
# driver is registered by `mise run init` and `ensure`, and without it a conflict is plain.
research/parity/expected/*.toml merge=expected-pins
