# Stored LF everywhere; Windows launchers stay CRLF so cmd.exe keeps parsing them.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Markdown keeps trailing spaces (hard breaks, .editorconfig), so `git diff --check` and the
# pre-commit hook do not count them as whitespace errors.
*.md whitespace=-blank-at-eol
*.png binary
*.idx binary
*.layer binary
*.jpg binary
*.zip binary
*.glb binary
# Append-only results table: keep the rows both branches added.
research/parity/log.md merge=union
