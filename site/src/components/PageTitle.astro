---
// Starlight's page title, then the page's description (a research note's `summary:`), which
// Starlight otherwise puts in <meta> only. "_top" is the id Starlight's table of contents and
// skip link expect on the title.
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="sr-summary">{description}</p>}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
		.sr-summary {
			margin-top: 1rem;
			font-size: var(--sl-text-lg);
			line-height: 1.5;
			color: var(--sl-color-gray-2);
		}
	}
</style>
