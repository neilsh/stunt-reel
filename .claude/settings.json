{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh issue close:*)",
      "PowerShell(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "PowerShell(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "PowerShell(gh issue edit:*)",
      "Bash(mise run *)",
      "PowerShell(mise run *)",
      "Bash(mise exec -- uv run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git switch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin *)",
      "Bash(git rebase origin/main*)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git push -u origin *)",
      "Bash(git rev-parse*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge * --squash --auto --delete-branch)",
      "Bash(gh pr merge * --disable-auto)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh repo view *)",
      "Bash(orca orchestration *)",
      "Bash(orca skills get *)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *:main*)",
      "Bash(git push * main *)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git commit -a*)",
      "Bash(git commit * -a *)",
      "Bash(git commit * -a)",
      "Bash(git commit *--all*)",
      "Bash(git add -A*)",
      "Bash(git add *--all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add corpus*)",
      "Bash(git add * corpus*)",
      "Bash(git add *./corpus*)",
      "Bash(git add *-- corpus*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(mise run reap *--force*)",
      "PowerShell(mise run reap *--force*)",
      "Bash(git worktree remove*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "mise run cloud-session-start",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
