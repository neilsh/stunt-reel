 /// metres. The vertices sit at 0.92 of the radius so the faces straddle the true sphere.
 /// Splitting the faces once makes the world's vertex buffer exceed wgpu's 256 MiB limit on
 /// `CTRY.FLM` (its 2,300 trees carry 19 spheres each).
+fn block_polygons(
+    center: [f32; 3],
+    half: f32,
+    ground_y_offset: f32,
+    scale_factor: f32,
+    palette_index: u8,
+    visibility: VisibilityCondition,
+) -> Vec<RawPolygon> {
+    // Cube corners, bit 0 = +x, bit 1 = +y, bit 2 = +z.
+    const FACES: [[usize; 4]; 6] = [
+        [1, 3, 7, 5],
+        [0, 4, 6, 2],
+        [2, 6, 7, 3],
+        [0, 1, 5, 4],
+        [4, 5, 7, 6],
+        [0, 2, 3, 1],
+    ];
+    let corner = |i: usize| {
+        let sx = if i & 1 != 0 { 1.0 } else { -1.0 };
+        let sy = if i & 2 != 0 { 1.0 } else { -1.0 };
+        let sz = if i & 4 != 0 { 1.0 } else { -1.0 };
+        [
+            (center[0] + sx * half) * scale_factor,
+            (center[1] + sy * half + ground_y_offset) * scale_factor,
+            (center[2] + sz * half) * scale_factor,
+        ]
+    };
+    FACES
+        .iter()
+        .flat_map(|face| {
+            let vertices: Vec<[f32; 3]> = face.iter().map(|&i| corner(i)).collect();
+            let [nx, ny, nz] = compute_polygon_normal(&vertices);
+            let mut rev = vertices.clone();
+            rev.reverse();
+            let [rx, ry, rz] = compute_polygon_normal(&rev);
+            [
+                RawPolygon {
+                    vertex_palette: Vec::new(),
+                    vertices,
+                    palette_index,
+                    normal: [-nx, -ny, -nz],
+                    flags: 0,
+                    is_decal: false,
+                    visibility,
+                },
+                RawPolygon {
+                    vertex_palette: Vec::new(),
+                    vertices: rev,
+                    palette_index,
+                    normal: [-rx, -ry, -rz],
+                    flags: 0,
+                    is_decal: false,
+                    visibility,
+                },
+            ]
+        })
+        .collect()
+}
