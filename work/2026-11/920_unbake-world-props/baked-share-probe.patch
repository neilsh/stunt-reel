+
+/// Probe (#920): the bytes the world's upload writes, by class, and what un-baking would add.
+pub(crate) fn probe_bytes(
+    scene: &stunt_core::scene::FilmScene,
+    w: &stunt_core::world::World,
+    marks: &[u32],
+    keep: fn(&SodVertex) -> bool,
+) -> Result<(), String> {
+    use std::collections::{HashMap, HashSet};
+    use stunt_core::contracts::NodeKind;
+    let ir = &w.ir;
+    let classes: HashMap<u32, u8> = stunt_core::world::PROBE_NODE_CLASS
+        .lock()
+        .unwrap()
+        .iter()
+        .copied()
+        .collect();
+    let drawn: HashSet<u16> = stunt_core::world::PROBE_DRAWN
+        .lock()
+        .unwrap()
+        .iter()
+        .copied()
+        .collect();
+    let limit: u64 = std::env::var("DBG_PROBE_MAX_BUFFER")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(256 << 20);
+    let vsz = size_of::<SodVertex>();
+    let max_vertices = (limit / vsz as u64) as usize;
+    let max_indices = (limit / 4) as usize;
+    let mut meshes = ir.meshes().peekable();
+    let sources: Vec<Option<SourceSlice>> = ir
+        .nodes
+        .iter()
+        .map(|node| {
+            let mesh = meshes.next_if(|mesh| std::ptr::eq(mesh.node, node))?;
+            Some(SourceSlice {
+                index_offset: mesh.index_offset,
+                index_count: arena_index(mesh.indices.len()),
+                is_decal: mesh.is_decal(),
+            })
+        })
+        .collect();
+    let mesh_sources: Vec<SourceSlice> = sources.iter().flatten().copied().collect();
+    let mut plan = plan_upload(ir.vertices.len(), &ir.indices, &mesh_sources, max_vertices, max_indices);
+    let (edges, _) = plan_edges(&mut plan, ir, keep, marks);
+    println!(
+        "[probe] size_of SodVertex {vsz} apex 12 index 4 edge-index 4 prop-run 12; limit {limit}; chunks {}; nodes {} mesh nodes {} vertices {} indices {}",
+        plan.chunks.len(),
+        ir.nodes.len(),
+        mesh_sources.len(),
+        ir.vertices.len(),
+        ir.indices.len()
+    );
+    // class: 0 terrain+ocean, 1 flat ground, 2 snapped decal, 3 OP_TAP, 4 droppable, 5 unowned
+    let labels = ["terrain+ocean", "flat ground", "snapped decal", "OP_TAP", "dropped", "unowned"];
+    let mut vclass = vec![5u8; ir.vertices.len()];
+    let mut nodes_n = [0u64; 6];
+    let mut idx = [0u64; 6];
+    let mut edge = [0u64; 6];
+    let mut planned = plan.slices.iter();
+    let mut cpu_slices = 0u64;
+    let mut cpu_children = 0u64;
+    let mut cpu_name_bytes = 0u64;
+    for (n, (node, source)) in ir.nodes.iter().zip(&sources).enumerate() {
+        cpu_children += node.children.len() as u64;
+        cpu_name_bytes += node.name.len() as u64;
+        let Some(src) = source else { continue };
+        let runs = planned.next().ok_or("plan short")?;
+        cpu_slices += runs.len() as u64;
+        let class = match classes.get(&(n as u32)) {
+            Some(&c) => c as usize,
+            None => 0,
+        };
+        let NodeKind::Mesh { vertex_offset, vertex_count, .. } = node.kind else {
+            return Err("mesh source on a non-mesh node".into());
+        };
+        for v in vclass
+            .iter_mut()
+            .skip(vertex_offset as usize)
+            .take(vertex_count as usize)
+        {
+            *v = class as u8;
+        }
+        nodes_n[class] += 1;
+        idx[class] += u64::from(src.index_count);
+        edge[class] += runs.iter().map(|r| u64::from(r.edge_count)).sum::<u64>();
+    }
+    let mut verts = [0u64; 6];
+    for &c in &vclass {
+        verts[c as usize] += 1;
+    }
+    let mut runs_n = [0u64; 6];
+    let mut table_total = 0u64;
+    for chunk in &plan.chunks {
+        let table = chunk_prop_runs(&w.prop_runs, &chunk.vertex_ranges);
+        table_total += table.len() as u64;
+    }
+    for run in &w.prop_runs {
+        runs_n[vclass[run.first as usize] as usize] += 1;
+    }
+    let edge_total: u64 = edges.iter().map(|e| e.len() as u64).sum();
+    println!(
+        "[probe] uploaded: vertices {} (plan {}), indices {}, edge indices {} (slices {}), prop runs {} (source {})",
+        ir.vertices.len(),
+        plan.chunks.iter().map(|c| c.vertex_count).sum::<usize>(),
+        ir.indices.len(),
+        edge_total,
+        edge.iter().sum::<u64>(),
+        table_total,
+        w.prop_runs.len()
+    );
+    println!("class nodes vertices indices edge_indices prop_runs");
+    for c in 0..6 {
+        println!("{} {} {} {} {} {}", labels[c].replace(' ', "_"), nodes_n[c], verts[c], idx[c], edge[c], runs_n[c]);
+    }
+    // Placements.
+    let mut rec_class = [0u64; 5];
+    let mut dropped_shapes: HashMap<u16, u64> = HashMap::new();
+    let mut records_with_mesh = 0u64;
+    for r in &w.placements.records {
+        let Some(m) = r.mesh else { continue };
+        records_with_mesh += 1;
+        let mut seen = [false; 5];
+        for n in m.nodes.start..m.nodes.end {
+            if let Some(&c) = classes.get(&n) {
+                seen[c as usize] = true;
+            }
+        }
+        for c in 1..5 {
+            if seen[c] {
+                rec_class[c] += 1;
+            }
+        }
+        if seen[4] {
+            *dropped_shapes.entry(r.shape).or_default() += 1;
+        }
+    }
+    println!(
+        "[probe] records {} with mesh {}; with a flat node {}, snapped {}, OP_TAP {}, dropped {}",
+        w.placements.records.len(),
+        records_with_mesh,
+        rec_class[1],
+        rec_class[2],
+        rec_class[3],
+        rec_class[4]
+    );
+    let dropped_placements: u64 = dropped_shapes.values().sum();
+    // Shapes un-baking would add to `SceneRenderer::shapes`.
+    let (mut new_shapes, mut already, mut missing) = (0u64, 0u64, 0u64);
+    let (mut quad_bytes, mut line_bytes) = (0u64, 0u64);
+    for &id in dropped_shapes.keys() {
+        if drawn.contains(&id) {
+            already += 1;
+            continue;
+        }
+        let Some(shape) = scene.shape(id) else {
+            missing += 1;
+            continue;
+        };
+        new_shapes += 1;
+        let o = crate::outline::outlined(shape);
+        quad_bytes += (o.ir.vertices.len() * (vsz + 12) + o.ir.indices.len() * 4) as u64;
+        let mut ms = shape.meshes().peekable();
+        let srcs: Vec<Option<SourceSlice>> = shape
+            .nodes
+            .iter()
+            .map(|node| {
+                let mesh = ms.next_if(|mesh| std::ptr::eq(mesh.node, node))?;
+                Some(SourceSlice {
+                    index_offset: mesh.index_offset,
+                    index_count: arena_index(mesh.indices.len()),
+                    is_decal: mesh.is_decal(),
+                })
+            })
+            .collect();
+        let flat: Vec<SourceSlice> = srcs.iter().flatten().copied().collect();
+        let mut p = plan_upload(shape.vertices.len(), &shape.indices, &flat, max_vertices, max_indices);
+        let (e, _) = plan_edges(&mut p, shape, crate::outline::outlines, &[]);
+        let ec: u64 = e.iter().map(|v| v.len() as u64).sum();
+        line_bytes += (shape.vertices.len() * (vsz + 12) + shape.indices.len() * 4) as u64 + ec * 4;
+    }
+    println!(
+        "[probe] dropped placements {dropped_placements} of {} distinct shapes; already uploaded {already}, absent from scene {missing}, newly uploaded {new_shapes}: quad-outline bytes {quad_bytes}, line-list bytes {line_bytes}",
+        dropped_shapes.len()
+    );
+    println!(
+        "[probe] CPU GpuNode: size_of GpuNode {} GpuMeshSlice {} NodeId {}; nodes {} slices {} children {} name bytes {}",
+        size_of::<GpuNode>(),
+        size_of::<GpuMeshSlice>(),
+        size_of::<NodeId>(),
+        ir.nodes.len(),
+        cpu_slices,
+        cpu_children,
+        cpu_name_bytes
+    );
+    println!("[probe] size_of PlacementRecord {}", size_of::<stunt_core::world::PlacementRecord>());
+    Ok(())
+}
