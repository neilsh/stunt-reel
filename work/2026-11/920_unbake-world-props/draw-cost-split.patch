+/// Probe (#920): per frame, the world vertices and indices the walk draws, and those an
+/// extra frustum test on each ungated placement's own box would remove.
+pub fn probe_world_vertices(
+    scene: &FilmScene,
+    ticks: &[(usize, f32)],
+    height: u32,
+    viewport_rows: Option<u32>,
+    out_path: &std::path::Path,
+) -> Result<(), String> {
+    use std::io::Write as _;
+    struct Part {
+        v: u64,
+        i: u64,
+    }
+    struct Prop {
+        bounds: crate::mesh::NodeBounds,
+        discs: bool,
+        base: Part,
+        decal: Part,
+    }
+    let w = scene.world().ok_or("no world")?;
+    let placements = WorldPlacements::new(w);
+    let model = GpuModel::probe_cpu(&w.ir);
+    let mut node_vertices = vec![0u64; w.ir.nodes.len()];
+    let mut by_offset: HashMap<u32, u64> = HashMap::new();
+    for m in w.ir.meshes() {
+        node_vertices[m.node.id.0 as usize] = m.vertices.len() as u64;
+        by_offset.insert(m.index_offset, m.vertices.len() as u64);
+    }
+    let mut props = Vec::new();
+    for spans in placements.spans.iter().flatten() {
+        let mut lo = Vec3::splat(f32::INFINITY);
+        let mut hi = Vec3::splat(f32::NEG_INFINITY);
+        let mut discs = false;
+        let mut parts = Vec::new();
+        for span in [spans.base, spans.decal] {
+            let idx = &w.ir.indices[span.start as usize..span.end as usize];
+            let mut seen: Vec<u32> = idx.to_vec();
+            seen.sort_unstable();
+            seen.dedup();
+            for &i in &seen {
+                let v = &w.ir.vertices[i as usize];
+                let p = Vec3::from_array(v.position);
+                lo = lo.min(p);
+                hi = hi.max(p);
+                discs |= v.flags & stunt_core::contracts::VERTEX_FLAG_DISC != 0;
+            }
+            parts.push(Part {
+                v: seen.len() as u64,
+                i: idx.len() as u64,
+            });
+        }
+        if lo.x > hi.x {
+            continue;
+        }
+        let decal = parts.pop().ok_or("parts")?;
+        let base = parts.pop().ok_or("parts")?;
+        props.push(Prop {
+            bounds: crate::mesh::NodeBounds { min: lo, max: hi },
+            discs,
+            base,
+            decal,
+        });
+    }
+    let base_node = placements.base.map(|(n, _)| n);
+    let decal_node = placements.decal.map(|(n, _)| n);
+    eprintln!("[probe] placements with WORLD_BASE/WORLD_DECAL geometry: {}", props.len());
+    eprintln!(
+        "[probe] nodes {} vertices {} indices {} records {} with_mesh {} base {:?} decal {:?} meshes {} mesh_vertices {}",
+        w.ir.nodes.len(),
+        w.ir.vertices.len(),
+        w.ir.indices.len(),
+        placements.spans.len(),
+        placements.spans.iter().flatten().count(),
+        placements.base,
+        placements.decal,
+        w.ir.meshes().count(),
+        w.ir.meshes().map(|m| m.vertices.len()).sum::<usize>()
+    );
+    let file = std::fs::File::create(out_path).map_err(|e| e.to_string())?;
+    let mut out = std::io::BufWriter::new(file);
+    writeln!(
+        out,
+        "tick ground_v ground_i base_v base_i decal_v decal_i rm_base_v rm_base_i rm_decal_v rm_decal_i"
+    )
+    .map_err(|e| e.to_string())?;
+    for &(film_tick, eval_tick) in ticks {
+        let frame = scene.frame(eval_tick);
+        if !frame.world {
+            continue;
+        }
+        let mut controller = CameraController::default();
+        controller.set_authored_transform(frame.view);
+        if let Some(rows) = viewport_rows {
+            controller.projection_y_scale = height as f32 / rows.max(1) as f32;
+        }
+        let camera_uniform = controller.build_uniform_with_sky(frame.palette.sky);
+        let rotation_proj = Mat4::from_cols_array(&camera_uniform.rotation_proj);
+        let eye = controller.eye_position();
+        let world_matrix = eye_relative_matrix(eye, &Mat4::IDENTITY.to_cols_array());
+        let view_proj = rotation_proj * Mat4::from_cols_array(&world_matrix);
+        let lod_view = CameraTransform {
+            eye: frame.view.eye,
+            target: frame.view.target,
+            lens: frame.lens,
+            ..CameraTransform::default()
+        };
+        let dds = camera_uniform.disc_depth_scale;
+        let (ground, base, decals) =
+            model.collect_world_meshes(eye, Some(&lod_view), view_proj, dds);
+        let gv: u64 = ground
+            .iter()
+            .map(|s| by_offset.get(&s.index_offset).copied().unwrap_or(0))
+            .sum();
+        let gi: u64 = ground.iter().map(|s| u64::from(s.index_count)).sum();
+        let sum = |slices: &[(NodeId, GpuMeshSlice)]| -> (u64, u64) {
+            slices.iter().fold((0, 0), |(v, i), (n, s)| {
+                (v + node_vertices[n.0 as usize], i + u64::from(s.index_count))
+            })
+        };
+        let (bv, bi) = sum(&base);
+        let (dv, di) = sum(&decals);
+        let has_base = base.iter().any(|(n, _)| Some(*n) == base_node);
+        let has_decal = decals.iter().any(|(n, _)| Some(*n) == decal_node);
+        let (mut rbv, mut rbi, mut rdv, mut rdi) = (0u64, 0u64, 0u64, 0u64);
+        for p in &props {
+            if crate::mesh::probe_keeps(view_proj, p.bounds, p.discs, dds) {
+                continue;
+            }
+            if has_base {
+                rbv += p.base.v;
+                rbi += p.base.i;
+            }
+            if has_decal {
+                rdv += p.decal.v;
+                rdi += p.decal.i;
+            }
+        }
+        let (nb, nd) = (base.len(), decals.len());
+        writeln!(out, "{film_tick} {gv} {gi} {bv} {bi} {dv} {di} {rbv} {rbi} {rdv} {rdi} {nb} {nd}")
+            .map_err(|e| e.to_string())?;
+    }
+    Ok(())
+}
+
+/// Probe (#920): bit 1 skips world base fills, 2 base outlines, 4 decal fills, 8 decal
+/// outlines, 16 scissors every world base and decal draw to one pixel, 32 draws each
+/// draw's decal fills together, then its decal outlines together.
+fn probe_mask() -> u8 {
+    static MASK: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *MASK.get_or_init(|| {
+        std::env::var("STUNT_PROBE_WORLD")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    })
+}
