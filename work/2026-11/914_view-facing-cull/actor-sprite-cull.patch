+/// The camera's view test for every draw but the world's: whether a model's box can reach the
+/// view ([`GpuModel::in_frustum`]), so [`SceneRenderer::prepare`] skips a draw that covers no
+/// pixel before it walks, stages or encodes it.
+#[derive(Clone, Copy)]
+struct ViewTest {
+    /// Takes an eye-relative point to clip space.
+    rotation_proj: Mat4,
+    /// The lens' disc depth scale, which keeps a model with disc rim vertices.
+    disc_depth_scale: f32,
+}
+
+impl ViewTest {
+    /// Whether `model`, drawn by the eye-relative `matrix` (the one its uniform holds), can draw
+    /// a pixel.
+    fn sees(&self, model: &GpuModel, matrix: &[f32; 16]) -> bool {
+        model.in_frustum(
+            self.rotation_proj * Mat4::from_cols_array(matrix),
+            self.disc_depth_scale,
+        )
+    }
+
+    /// Which of an actor's draws, by their own eye-relative matrices, `model` can draw a pixel
+    /// in; a draw with no matrix (a body of a shadow-only actor, a missing shadow) draws none.
+    fn sees_actor(
+        &self,
+        model: &GpuModel,
+        body: Option<&[f32; 16]>,
+        shadow: Option<&[f32; 16]>,
+    ) -> ActorView {
+        ActorView {
+            body: body.is_some_and(|matrix| self.sees(model, matrix)),
+            shadow: shadow.is_some_and(|matrix| self.sees(model, matrix)),
+        }
+    }
+}
+
+/// Which of an actor's two draws can reach the view, each tested on its own: an off-screen body
+/// can cast an on-screen shadow, and the reverse.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct ActorView {
+    body: bool,
+    shadow: bool,
+}
+
+impl ActorView {
+    /// Whether either draw can.
+    const fn any(self) -> bool {
+        self.body || self.shadow
+    }
+}
