+/// Probe: one frame's base-pass merge counts.
+#[derive(Debug, Default, Clone)]
+pub struct BaseScan {
+    pub fills: usize,
+    pub fills_merged: usize,
+    pub edges: usize,
+    pub edges_merged: usize,
+    pub fill_idx: u64,
+    pub edge_idx: u64,
+    pub fill_ooo: usize,
+    pub edge_ooo: usize,
+    pub fill_now: usize,
+    pub edge_now: usize,
+    pub decals: usize,
+    pub decal_edges: usize,
+}
+
+type SliceKey = (u32, i32, u32, u32, u32, u32);
+
+fn slice_key(m: &GpuMeshSlice) -> SliceKey {
+    (m.chunk, m.vertex_offset, m.index_offset, m.index_count, m.edge_offset, m.edge_count)
+}
+
+/// Probe: the camera-independent walk order of the base slices.
+pub struct FixedWalk {
+    fill: std::collections::HashMap<SliceKey, usize>,
+    edge: std::collections::HashMap<SliceKey, usize>,
+    pub total_fills: usize,
+    pub total_edges: usize,
+    pub dup_keys: usize,
+}
+
+impl GpuModel {
+    pub fn fixed_walk(&self) -> FixedWalk {
+        let mut fill = std::collections::HashMap::new();
+        let mut edge = std::collections::HashMap::new();
+        let mut dup = 0;
+        let mut stack: Vec<NodeId> = self.root_nodes.clone();
+        while let Some(id) = stack.pop() {
+            let Some(node) = self.nodes.get(id.0 as usize) else { continue };
+            if node.name != GROUND_NODE {
+                for m in node.meshes.iter().filter(|m| !m.is_decal) {
+                    let n = fill.len();
+                    if fill.insert(slice_key(m), n).is_some() { dup += 1; }
+                    if m.edge_count > 0 {
+                        let n = edge.len();
+                        edge.insert(slice_key(m), n);
+                    }
+                }
+            }
+            stack.extend(&node.children);
+        }
+        FixedWalk { total_fills: fill.len(), total_edges: edge.len(), fill, edge, dup_keys: dup }
+    }
+
+    pub fn scan_base(
+        &self,
+        fixed: &FixedWalk,
+        eye: Vec3,
+        view: Option<&CameraTransform>,
+        view_proj: Mat4,
+        disc_depth_scale: f32,
+    ) -> BaseScan {
+        let (_, base, decals) = self.collect_world_meshes(eye, view, view_proj, disc_depth_scale);
+        let mut out = BaseScan::default();
+        out.decals = decals.len();
+        out.decal_edges = decals.iter().filter(|(_, m)| m.edge_count > 0).count();
+        let mut prev: Option<(GpuMeshSlice, usize)> = None;
+        let mut prev_e: Option<(GpuMeshSlice, usize)> = None;
+        for (_, m) in &base {
+            out.fills += 1;
+            out.fill_idx += u64::from(m.index_count);
+            let pos = *fixed.fill.get(&slice_key(m)).expect("fill in fixed walk");
+            if let Some((p, pp)) = prev {
+                if pos < pp { out.fill_ooo += 1; }
+                if pos == pp + 1 && p.chunk == m.chunk && p.vertex_offset == m.vertex_offset {
+                    out.fills_merged += 1;
+                }
+                if p.chunk == m.chunk && p.vertex_offset == m.vertex_offset
+                    && m.index_offset == p.index_offset + p.index_count { out.fill_now += 1; }
+            }
+            prev = Some((*m, pos));
+            if m.edge_count > 0 {
+                out.edges += 1;
+                out.edge_idx += u64::from(m.edge_count);
+                let pos = *fixed.edge.get(&slice_key(m)).expect("edge in fixed walk");
+                if let Some((p, pp)) = prev_e {
+                    if pos < pp { out.edge_ooo += 1; }
+                    if pos == pp + 1 && p.chunk == m.chunk && p.vertex_offset == m.vertex_offset {
+                        out.edges_merged += 1;
+                    }
+                    if p.chunk == m.chunk && p.vertex_offset == m.vertex_offset
+                        && m.edge_offset == p.edge_offset + p.edge_count { out.edge_now += 1; }
+                }
+                prev_e = Some((*m, pos));
+            }
+        }
+        out
+    }
+}
