+                (0, 0, 15..18),
+                (0, 0, 12..15),
+                (0, 4, 15..18),
+                (1, 4, 18..21),
+            ]
+        );
+    }
+
+    /// A one-triangle mesh node at arena offset `3 * n`, under `parent`.
+    fn triangle_node(
+        ir: &mut SodModelIr,
+        name: &str,
+        parent: NodeId,
+        n: u32,
+        is_decal: bool,
+    ) -> NodeId {
+        ir.allocate_node(
+            name,
+            Some(parent),
+            Mat4::IDENTITY.to_cols_array(),
+            VisibilityCondition::Always,
+            NodeKind::Mesh {
+                vertex_offset: 0,
+                vertex_count: arena_index(ir.vertices.len()),
+                index_offset: 3 * n,
+                index_count: 3,
+                is_decal,
+            },
+        )
+    }
+
+    /// The walk the world's draw makes, ungated.
+    fn ungated_walk<'a>(nodes: &'a [GpuNode], roots: &'a [NodeId]) -> VisibleWalk<'a> {
+        VisibleWalk {
+            nodes,
+            roots,
+            state_mask: 0,
+            dist_sq: 0.0,
+            eye: Vec3::ZERO,
+            view: None,
+            view_proj: None,
+            disc_depth_scale: 1.0,
+            flattened_by: None,
+        }
+    }
+
+    /// The source vertices `slices` draw from `buffer`, in draw order.
+    fn drawn_from(buffer: &[u32], slices: &[GpuMeshSlice], edges: bool) -> Vec<u32> {
+        slices
+            .iter()
+            .flat_map(|s| {
+                let (start, count) = if edges {
+                    (s.edge_offset, s.edge_count)
+                } else {
+                    (s.index_offset, s.index_count)
+                };
+                buffer[start as usize..(start + count) as usize]
+                    .iter()
+                    .copied()
+            })
+            .collect()
+    }
+
+    /// The world's base slices lie in the walk's order, so the walk's neighbours are drawn
+    /// with one call, fills and outlines alike, and every slice still draws its own triangles.
+    #[test]
+    fn the_walk_order_layout_draws_walk_neighbours_with_one_call() {
+        // Root group R holds A (with child A1), B, decal D and ground G, in that order.
+        let mut ir = numbered_ir(15, &(0..15).collect::<Vec<_>>());
+        let root = ir.allocate_node(
+            "R",
+            None,
+            Mat4::IDENTITY.to_cols_array(),
+            VisibilityCondition::Always,
+            NodeKind::TransformGroup,
+        );
+        let a = triangle_node(&mut ir, "A", root, 0, false);
+        triangle_node(&mut ir, "A1", a, 1, false);
+        triangle_node(&mut ir, "B", root, 2, false);
+        triangle_node(&mut ir, "D", root, 3, true);
+        triangle_node(&mut ir, GROUND_NODE, root, 4, false);
+        let layout = ModelLayout::of(&ir, Some((|_| true, &[])), usize::MAX, usize::MAX);
+        let (ground, base, decals) = ungated_walk(&layout.nodes, &ir.root_nodes).collect_world();
+        let untag = |tagged: Vec<(NodeId, GpuMeshSlice)>| -> Vec<GpuMeshSlice> {
+            tagged.into_iter().map(|(_, slice)| slice).collect()
+        };
+        let (base, decals) = (untag(base), untag(decals));
+        let indices = layout.chunks[0].indices.as_deref().expect("laid out");
+        // Last sibling first: B, then A and its child A1.
+        assert_eq!(
+            drawn_from(indices, &base, false),
+            [6, 7, 8, 0, 1, 2, 3, 4, 5]
+        );
+        assert_eq!(drawn_from(indices, &decals, false), [9, 10, 11]);
+        assert_eq!(drawn_from(indices, &ground, false), [12, 13, 14]);
+        let runs = |edges: bool| {
+            let mut runs = Vec::new();
+            let ranges = base.iter().map(|s| {
+                let (start, count) = if edges {
+                    (s.edge_offset, s.edge_count)
+                } else {
+                    (s.index_offset, s.index_count)
+                };
+                (s.chunk, s.vertex_offset, start..start + count)
+            });
+            for_each_run(ranges, |_, _, range| runs.push((range.start, range.end)));
+            runs
+        };
+        assert_eq!(runs(false), [(0, 9)]);
+        assert_eq!(runs(true), [(0, 18)]);
+        let outline = drawn_from(&layout.edges[0], &base, true);
+        let corners = |from: usize| {
+            let mut corners = outline[from..from + 6].to_vec();
+            corners.sort_unstable();
+            corners.dedup();
+            corners
+        };
+        assert_eq!(
+            [corners(0), corners(6), corners(12)],
+            [vec![6, 7, 8], vec![0, 1, 2], vec![3, 4, 5]]
+        );
+    }
+
+    /// A cut takes offsets in the source arena and gives the moved slice's offsets in the
+    /// laid-out index and edge buffers.
+    #[test]
+    fn a_cut_of_a_moved_slice_draws_the_arena_indices_it_names() {
+        // P's two quads come first in the arena, Q's triangle after; the walk draws Q first.
+        let mut ir = numbered_ir(11, &[0, 1, 2, 0, 2, 3, 4, 5, 6, 4, 6, 7, 8, 9, 10]);
+        let root = ir.allocate_node(
+            "R",
+            None,
+            Mat4::IDENTITY.to_cols_array(),
+            VisibilityCondition::Always,
+            NodeKind::TransformGroup,
+        );
+        let p = ir.allocate_node(
+            "P",
+            Some(root),
+            Mat4::IDENTITY.to_cols_array(),
+            VisibilityCondition::Always,
+            NodeKind::Mesh {
+                vertex_offset: 0,
+                vertex_count: 11,
+                index_offset: 0,
+                index_count: 12,
+                is_decal: false,
+            },
+        );
+        triangle_node(&mut ir, "Q", root, 4, false);
+        let layout = ModelLayout::of(&ir, Some((|_| true, &[0, 6, 12])), usize::MAX, usize::MAX);
+        let indices = layout.chunks[0].indices.clone().expect("laid out");
+        let edges = layout.edges[0].clone();
+        let model = GpuModel {
+            name: ir.name.clone(),
+            chunks: Vec::new(),
+            vertex_count: 11,
+            index_count: 15,
+            nodes: layout.nodes,
+            root_nodes: ir.root_nodes.clone(),
+            bounds: layout.bounds,
+            discs: false,
+        };
+        let second = model.cut(p, 6, 12).expect("both ends are marks");
+        // Q's triangle and its three edges come first.
+        assert_eq!((second.index_offset, second.index_count), (9, 6));
+        assert_eq!((second.edge_offset, second.edge_count), (6 + 8, 8));
+        assert_eq!(drawn_from(&indices, &[second], false), ir.indices[6..12]);
+        let mut corners = drawn_from(&edges, &[second], true);
+        corners.sort_unstable();
+        corners.dedup();
+        assert_eq!(corners, [4, 5, 6, 7]);
+        assert_eq!(
+            model.cut(p, 0, 12),
+            Some(model.nodes[p.0 as usize].meshes[0])
+        );
+        assert!(model.cut(p, 3, 12).is_none(), "3 is no mark");
+    }
 }
