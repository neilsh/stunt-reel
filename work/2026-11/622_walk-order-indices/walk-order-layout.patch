+/// Calls `draw` once for each run of `ranges` (chunk, base vertex, index range) in which
+/// each range starts where the one before it ends, in the same chunk at the same base vertex,
+/// with the run's ranges joined; runs keep `ranges`' order.
+///
+/// One call draws its primitives in index order, as the separate calls would, so a depth tie
+/// is won by the same triangle.
+fn for_each_run(
+    ranges: impl IntoIterator<Item = (u32, i32, Range<u32>)>,
+    mut draw: impl FnMut(u32, i32, Range<u32>),
+) {
+    let mut open: Option<(u32, i32, Range<u32>)> = None;
+    for (chunk, base_vertex, range) in ranges {
+        if let Some((c, b, run)) = &mut open
+            && (*c, *b, run.end) == (chunk, base_vertex, range.start)
+        {
+            run.end = range.end;
+            continue;
+        }
+        if let Some((c, b, run)) = open.replace((chunk, base_vertex, range)) {
+            draw(c, b, run);
+        }
+    }
+    if let Some((c, b, run)) = open {
+        draw(c, b, run);
+    }
+}
