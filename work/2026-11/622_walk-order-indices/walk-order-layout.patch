+/// A model's chunks, outlines and nodes as [`GpuModel::upload`] uploads them, before any
+/// buffer exists.
+struct ModelLayout {
+    chunks: Vec<ChunkPlan>,
+    /// Each chunk's outline indices.
+    edges: Vec<Vec<u32>>,
+    nodes: Vec<GpuNode>,
+    /// [`GpuModel::bounds`].
+    bounds: Option<NodeBounds>,
+}
+
+impl ModelLayout {
+    /// Plans `ir` over chunks of at most `max_vertices` vertices and `max_indices` indices,
+    /// with `outlined`'s outlines and marks and, then, the walk-order layout
+    /// ([`GpuModel::from_ir_outlined`]).
+    fn of(
+        ir: &SodModelIr,
+        outlined: Option<Outlines<'_>>,
+        max_vertices: usize,
+        max_indices: usize,
+    ) -> Self {
+        // One source per mesh slice, keyed by node so the planned slices can be handed
+        // back to the same nodes. `meshes()` already skips a node whose window is unsafe.
+        // `meshes()` walks the nodes in arena order, so each node takes the next mesh if
+        // that mesh is its own.
+        let mut meshes = ir.meshes().peekable();
+        let sources: Vec<Option<SourceSlice>> = ir
+            .nodes
+            .iter()
+            .map(|node| {
+                let mesh = meshes.next_if(|mesh| std::ptr::eq(mesh.node, node))?;
+                Some(SourceSlice {
+                    index_offset: mesh.index_offset,
+                    index_count: arena_index(mesh.indices.len()),
+                    is_decal: mesh.is_decal(),
+                })
+            })
+            .collect();
+        let mesh_sources: Vec<SourceSlice> = sources.iter().flatten().copied().collect();
+        let mut plan = plan_upload(
+            ir.vertices.len(),
+            &ir.indices,
+            &mesh_sources,
+            max_vertices,
+            max_indices,
+        );
+        let (mut edges, mut marks) = match outlined {
+            Some((keep, marks)) => plan_edges(&mut plan, ir, keep, marks),
+            None => (vec![Vec::new(); plan.chunks.len()], Vec::new()),
+        };
+        marks.resize_with(plan.slices.len(), Vec::new);
+        // Each node's slice number in `plan.slices`.
+        let slice_of: Vec<Option<usize>> = sources
+            .iter()
+            .scan(0, |next, source| {
+                Some(source.map(|_| {
+                    *next += 1;
+                    *next - 1
+                }))
+            })
+            .collect();
+        if outlined.is_some() {
+            lay_out_in_walk_order(
+                &mut plan,
+                &mut edges,
+                &mut marks,
+                ir,
+                &slice_of,
+                max_indices,
             );
         }
+
+        // Translate nodes into GpuNode flat arena
+        let mut planned = plan.slices.into_iter().zip(marks);
+        let bounds = node_bounds(ir);
+        let discs = node_discs(ir);
+        let nodes = ir
+            .nodes
+            .iter()
+            .zip(&sources)
+            .enumerate()
+            .map(|(n, (node, source))| {
+                let (meshes, marks) = source.and_then(|_| planned.next()).unwrap_or_default();
+                GpuNode {
+                    id: node.id,
+                    name: node.name.clone(),
+                    parent: node.parent,
+                    children: node.children.clone(),
+                    local_matrix: Mat4::from_cols_array(&node.local_matrix),
+                    visibility: node.visibility,
+                    meshes,
+                    bounds: bounds.get(n).copied().flatten(),
+                    discs: discs.get(n).copied().unwrap_or(false),
+                    marks,
+                }
+            })
+            .collect();
+        Self {
+            chunks: plan.chunks,
+            edges,
+            nodes,
+            bounds: model_bounds(&ir.root_nodes, &bounds),
+        }
     }
 }
 
+/// Rewrites a one-chunk `plan`'s index buffer, and its outlines in `edges`, to hold the base
+/// slices first, in the order [`VisibleWalk::walk`] emits them over every node (depth first,
+/// last sibling first), then every other slice ([`GROUND_NODE`] nodes' and decals) in arena
+/// order; each slice's offsets, and its `marks` (by slice), move with it.
+///
+/// The walk's gates and cull only skip nodes, so the base slices of the nodes a frame keeps
+/// come in this order, and those of two nodes it visits one after the other lie end to end:
+/// [`GpuModel::draw_slices`] draws them with one call in the same order. Indices no slice
+/// draws are dropped. A split plan, whose runs each have their own base vertex, is left as
+/// it is, as is one whose slices would need more than `max_indices` indices.
+fn lay_out_in_walk_order(
+    plan: &mut UploadPlan,
+    edges: &mut [Vec<u32>],
+    marks: &mut [Vec<CutMark>],
+    ir: &SodModelIr,
+    slice_of: &[Option<usize>],
+    max_indices: usize,
+) {
+    let ([chunk], [chunk_edges]) = (plan.chunks.as_mut_slice(), edges) else {
+        return;
+    };
+    if chunk.indices.is_some() {
+        return;
+    }
+    let count = plan.slices.len();
+    let mut placed = vec![false; count];
+    let mut order = Vec::with_capacity(count);
+    let mut stack: Vec<NodeId> = ir.root_nodes.clone();
+    while let Some(id) = stack.pop() {
+        let Some(node) = ir.nodes.get(id.0 as usize) else {
+            continue;
+        };
+        if let Some(s) = slice_of.get(id.0 as usize).copied().flatten()
+            && node.name != GROUND_NODE
+            && plan
+                .slices
+                .get(s)
+                .is_some_and(|runs| runs.iter().all(|run| !run.is_decal))
+            && let Some(seen) = placed.get_mut(s)
+            && !std::mem::replace(seen, true)
+        {
+            order.push(s);
+        }
+        stack.extend(&node.children);
+    }
+    order.extend((0..count).filter(|&s| placed.get(s) == Some(&false)));
+
+    let total: usize = order
+        .iter()
+        .filter_map(|&s| plan.slices.get(s))
+        .flatten()
+        .map(|run| run.index_count as usize)
+        .sum();
+    if total > max_indices {
+        return;
+    }
+    let mut indices = Vec::with_capacity(total);
+    let mut outline = Vec::with_capacity(chunk_edges.len());
+    // Each slice's new index and edge offsets, by slice; an unsplit plan gives a slice one run.
+    let mut moved = vec![(0, 0); count];
+    for s in order {
+        let (Some([run]), Some(to)) = (plan.slices.get(s).map(Vec::as_slice), moved.get_mut(s))
+        else {
+            return;
+        };
+        let (index_from, edge_from) = (run.index_offset as usize, run.edge_offset as usize);
+        let (Some(triangles), Some(lines)) = (
+            ir.indices
+                .get(index_from..index_from + run.index_count as usize),
+            chunk_edges.get(edge_from..edge_from + run.edge_count as usize),
+        ) else {
+            return;
+        };
+        *to = (arena_index(indices.len()), arena_index(outline.len()));
+        indices.extend_from_slice(triangles);
+        outline.extend_from_slice(lines);
+    }
+    for ((runs, marks), (index, edge)) in plan.slices.iter_mut().zip(marks).zip(moved) {
+        for run in runs {
+            // Each mark lies in its slice, so neither subtraction can wrap.
+            for mark in marks.iter_mut() {
+                mark.index = index + (mark.index - run.index_offset);
+                mark.edge = edge + (mark.edge - run.edge_offset);
+            }
+            run.index_offset = index;
+            run.edge_offset = edge;
+        }
+    }
+    chunk.indices = Some(indices);
+    *chunk_edges = outline;
+}
