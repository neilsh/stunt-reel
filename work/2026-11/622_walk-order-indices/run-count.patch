+/// Probe: CPU-only world base draw scan.
+pub fn cpu_scan_world(
+    scene: &FilmScene,
+    ticks: &[(usize, f32)],
+    height: u32,
+    viewport_rows: Option<u32>,
+    out_path: &std::path::Path,
+) -> Result<(), String> {
+    use std::io::Write as _;
+    let placements = scene.world().map_or_default(WorldPlacements::new);
+    let world = scene
+        .world()
+        .map(|w| GpuModel::probe_world(&w.ir, outlines_in_world, &placements.marks()))
+        .ok_or("no world")?;
+    let file = std::fs::File::create(out_path).map_err(|e| e.to_string())?;
+    let mut w = std::io::BufWriter::new(file);
+    for &(film_tick, eval_tick) in ticks {
+        let frame = scene.frame(eval_tick);
+        if !frame.world {
+            continue;
+        }
+        let mut controller = CameraController::default();
+        controller.set_authored_transform(frame.view);
+        if let Some(rows) = viewport_rows {
+            controller.projection_y_scale = height as f32 / rows.max(1) as f32;
+        }
+        let camera_uniform = controller.build_uniform_with_sky(frame.palette.sky);
+        let rotation_proj = Mat4::from_cols_array(&camera_uniform.rotation_proj);
+        let eye = controller.eye_position();
+        let world_matrix = eye_relative_matrix(eye, &Mat4::IDENTITY.to_cols_array());
+        let view_proj = rotation_proj * Mat4::from_cols_array(&world_matrix);
+        let lod_view = CameraTransform {
+            eye: frame.view.eye,
+            target: frame.view.target,
+            lens: frame.lens,
+            ..CameraTransform::default()
+        };
+        let [f, fr, e, er] = world.probe_runs(eye, Some(&lod_view), view_proj, camera_uniform.disc_depth_scale);
+        let placed = frame.sprites.iter().filter(|s| s.after.is_some()).count();
+        writeln!(w, "{film_tick} {f} {fr} {e} {er} {placed}").map_err(|e| e.to_string())?;
+    }
+    Ok(())
+}
