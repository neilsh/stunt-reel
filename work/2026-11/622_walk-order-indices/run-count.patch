+/// Probe: CPU-only world model and its base draw counts.
+impl GpuModel {
+    pub(crate) fn probe_world(ir: &SodModelIr, outlined: fn(&SodVertex) -> bool, marks: &[u32]) -> Self {
+        let max = (1u64 << 28) as usize;
+        let layout = ModelLayout::of(ir, Some((outlined, marks)), max / size_of::<SodVertex>(), max / 4);
+        assert_eq!(layout.chunks.len(), 1, "one chunk");
+        Self {
+            name: ir.name.clone(),
+            chunks: Vec::new(),
+            vertex_count: 0,
+            index_count: 0,
+            nodes: layout.nodes,
+            root_nodes: ir.root_nodes.clone(),
+            bounds: layout.bounds,
+            discs: false,
+        }
+    }
+
+    pub(crate) fn probe_runs(&self, eye: Vec3, view: Option<&CameraTransform>, view_proj: Mat4, dds: f32) -> [usize; 4] {
+        let (_, base, _) = self.collect_world_meshes(eye, view, view_proj, dds);
+        let mut fill_runs = 0;
+        for_each_run(base.iter().map(|(_, m)| (m.chunk, m.vertex_offset, m.index_offset..m.index_offset + m.index_count)), |_, _, _| fill_runs += 1);
+        let edges: Vec<_> = base.iter().filter(|(_, m)| m.edge_count > 0).collect();
+        let mut edge_runs = 0;
+        for_each_run(edges.iter().map(|(_, m)| (m.chunk, m.vertex_offset, m.edge_offset..m.edge_offset + m.edge_count)), |_, _, _| edge_runs += 1);
+        [base.len(), fill_runs, edges.len(), edge_runs]
+    }
+}
