+fn overlaps_in_plane(a: &RawPolygon, b: &RawPolygon, tol: f32) -> bool {
+    let n = front_normal(a);
+    let axis = (0..3)
+        .max_by(|&p, &q| n[p].abs().total_cmp(&n[q].abs()))
+        .unwrap_or(0);
+    let (min_a, max_a) = polygon_bounds(a);
+    let (min_b, max_b) = polygon_bounds(b);
+    (0..3)
+        .filter(|&k| k != axis)
+        .all(|k| min_a[k] < max_b[k] - tol && max_a[k] > min_b[k] + tol)
+}
