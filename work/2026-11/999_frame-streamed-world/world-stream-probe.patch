+/// Probe (#999): the world's node arena as [`GpuModel::from_ir_outlined`] plans it, with no
+/// device and no buffers, and the number of chunks the plan holds under `limit` bytes a buffer.
+impl GpuModel {
+    pub(crate) fn probe_plan(
+        ir: &SodModelIr,
+        keep: fn(&SodVertex) -> bool,
+        marks: &[u32],
+        limit: u64,
+    ) -> (Self, usize) {
+        let max_vertices =
+            usize::try_from(limit / size_of::<SodVertex>() as u64).unwrap_or(usize::MAX);
+        let max_indices = usize::try_from(limit / size_of::<u32>() as u64).unwrap_or(usize::MAX);
+        let mut meshes = ir.meshes().peekable();
+        let sources: Vec<Option<SourceSlice>> = ir
+            .nodes
+            .iter()
+            .map(|node| {
+                let mesh = meshes.next_if(|mesh| std::ptr::eq(mesh.node, node))?;
+                Some(SourceSlice {
+                    index_offset: mesh.index_offset,
+                    index_count: arena_index(mesh.indices.len()),
+                    is_decal: mesh.is_decal(),
+                })
+            })
+            .collect();
+        let mesh_sources: Vec<SourceSlice> = sources.iter().flatten().copied().collect();
+        let mut plan = plan_upload(
+            ir.vertices.len(),
+            &ir.indices,
+            &mesh_sources,
+            max_vertices,
+            max_indices,
+        );
+        let (_edges, mut marks) = plan_edges(&mut plan, ir, keep, marks);
+        let chunk_count = plan.chunks.len();
+        marks.resize_with(plan.slices.len(), Vec::new);
+        let mut planned = plan.slices.into_iter().zip(marks);
+        let bounds = node_bounds(ir);
+        let discs = node_discs(ir);
+        let nodes = ir
+            .nodes
+            .iter()
+            .zip(&sources)
+            .enumerate()
+            .map(|(n, (node, source))| {
+                let (meshes, marks) = source.and_then(|_| planned.next()).unwrap_or_default();
+                GpuNode {
+                    id: node.id,
+                    name: node.name.clone(),
+                    parent: node.parent,
+                    children: node.children.clone(),
+                    local_matrix: Mat4::from_cols_array(&node.local_matrix),
+                    visibility: node.visibility,
+                    meshes,
+                    bounds: bounds.get(n).copied().flatten(),
+                    discs: discs.get(n).copied().unwrap_or(false),
+                    marks,
+                }
+            })
+            .collect();
+        let bounds = model_bounds(&ir.root_nodes, &bounds);
+        let model = Self {
+            name: ir.name.clone(),
+            chunks: Vec::new(),
+            vertex_count: arena_index(ir.vertices.len()),
+            index_count: arena_index(ir.indices.len()),
+            nodes,
+            root_nodes: ir.root_nodes.clone(),
+            bounds,
+            discs: ir
+                .vertices
+                .iter()
+                .any(|vertex| vertex.flags & VERTEX_FLAG_DISC != 0),
+        };
+        (model, chunk_count)
+    }
+
+    /// Probe (#999): [`Self::collect_world_meshes`]'s slices in the order a stream would hold
+    /// them (ground, base, decal), each with its node and its list (0 ground, 1 base, 2 decal).
+    pub(crate) fn probe_world_walk(
+        &self,
+        eye: Vec3,
+        view: Option<&CameraTransform>,
+        view_proj: Mat4,
+        disc_depth_scale: f32,
+    ) -> Vec<(NodeId, GpuMeshSlice, u8)> {
+        let walk = VisibleWalk {
+            nodes: &self.nodes,
+            roots: &self.root_nodes,
+            state_mask: 0,
+            dist_sq: 0.0,
+            eye,
+            view,
+            view_proj: Some(view_proj),
+            disc_depth_scale,
+            flattened_by: None,
+        };
+        let is_ground = |node: &GpuNode| node.name == GROUND_NODE;
+        let (mut ground, mut base, mut decals) = (Vec::new(), Vec::new(), Vec::new());
+        walk.walk(false, |node, mesh| {
+            if !is_ground(node) && !mesh.is_decal {
+                base.push((node.id, mesh, 1));
+            }
+        });
+        walk.walk(true, |node, mesh| {
+            if is_ground(node) {
+                ground.push((node.id, mesh, 0));
+            } else if mesh.is_decal {
+                decals.push((node.id, mesh, 2));
+            }
+        });
+        ground.extend(base);
+        ground.extend(decals);
+        ground
+    }
+}
