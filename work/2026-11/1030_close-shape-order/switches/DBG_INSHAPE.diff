+/// DBG_INSHAPE (#1030, temporary): the polygons, spheres, SORTs and RETURNs of one walk.
+#[derive(Clone, Debug)]
+pub enum DbgEv {
+    /// A polygon: metric vertices, palette index, gate.
+    Poly(Vec<[f32; 3]>, u8, VisibilityCondition),
+    /// A sphere: metric centre, metric radius, palette index, gate.
+    Sphere([f32; 3], f32, u8, VisibilityCondition),
+    /// A SORT whose branches were queued: the flag's gate if a REJ set it.
+    Sort(Option<VisibilityCondition>),
+    /// A RETURN.
+    Ret,
+}
+thread_local! {
+    /// DBG_INSHAPE recorder; `Some` records.
+    pub static DBG_REC: std::cell::RefCell<Option<Vec<DbgEv>>> = const { std::cell::RefCell::new(None) };
+}
+fn dbg_push(ev: DbgEv) {
+    DBG_REC.with(|r| {
+        if let Some(v) = r.borrow_mut().as_mut() {
+            v.push(ev);
+        }
+    });
+}
