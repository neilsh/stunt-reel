+// Ratio of the distance of the point where the ray through `clip`'s snapped pixel meets the plane
+// of `normal` to the vertex's own distance; -1 when it does not meet in front of the eye.
+fn slide_ratio(clip: vec4<f32>, eye: vec4<f32>, normal: vec3<f32>) -> f32 {
