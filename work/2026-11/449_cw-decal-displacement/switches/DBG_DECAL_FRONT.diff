+/// Whether two coplanar convex polygons share area deeper than `tol`: no separating axis among
+/// their edge normals, in the plane of `a`'s [`front_normal`]. Touching along an edge is not
+/// overlap.
+fn areas_overlap(a: &RawPolygon, b: &RawPolygon, tol: f32) -> bool {
+    let n = front_normal(a);
+    // Drop the axis the plane faces most, keeping a 2D projection of non-zero area.
+    let (i, j) = if n[0].abs() >= n[1].abs() && n[0].abs() >= n[2].abs() {
+        (1, 2)
+    } else if n[1].abs() >= n[2].abs() {
+        (0, 2)
+    } else {
+        (0, 1)
+    };
+    let flat = |p: &RawPolygon| -> Vec<[f32; 2]> { p.vertices.iter().map(|v| [v[i], v[j]]).collect() };
+    let (pa, pb) = (flat(a), flat(b));
+    let span = |pts: &[[f32; 2]], axis: [f32; 2]| {
+        pts.iter().fold((f32::INFINITY, f32::NEG_INFINITY), |(lo, hi), p| {
+            let d = p[0] * axis[0] + p[1] * axis[1];
+            (lo.min(d), hi.max(d))
+        })
+    };
+    for pts in [&pa, &pb] {
+        for (p, q) in pts.iter().zip(pts.iter().cycle().skip(1)) {
+            let e = [q[0] - p[0], q[1] - p[1]];
+            let len = e[0].hypot(e[1]);
+            if len < 1e-9 {
+                continue;
+            }
+            let axis = [-e[1] / len, e[0] / len];
+            let (a_lo, a_hi) = span(&pa, axis);
+            let (b_lo, b_hi) = span(&pb, axis);
+            if a_hi.min(b_hi) - a_lo.max(b_lo) <= tol {
+                return false;
+            }
+        }
+    }
+    true
+}
