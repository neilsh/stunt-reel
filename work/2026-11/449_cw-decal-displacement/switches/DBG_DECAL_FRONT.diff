+    let d_b = n_b[0] * b0[0] + n_b[1] * b0[1] + n_b[2] * b0[2];
+    if (d_a - d_b).abs() > plane_tol { return false; }
+    let (min_a, max_a) = polygon_bounds(a);
+    let (min_b, max_b) = polygon_bounds(b);
+    bounds_overlap(&min_a, &max_a, &min_b, &max_b, plane_tol)
