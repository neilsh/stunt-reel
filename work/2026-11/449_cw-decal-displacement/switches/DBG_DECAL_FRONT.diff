+fn old_coplanar(a: &RawPolygon, b: &RawPolygon, normal_tol: f32, plane_tol: f32) -> bool {
+    let (Some(a0), Some(b0)) = (a.vertices.first(), b.vertices.first()) else { return false; };
+    let (n_a, n_b) = (a.normal, b.normal);
+    let dot_n = n_a[0] * n_b[0] + n_a[1] * n_b[1] + n_a[2] * n_b[2];
+    if dot_n < 1.0 - normal_tol { return false; }
