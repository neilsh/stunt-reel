+/// DBG_SORT_FACING prototype: a facing gate's faces, each with whether it must face away.
+pub(crate) fn gate_faces(v: VisibilityCondition) -> Option<Vec<([f32; 6], bool)>> {
+    match v {
+        VisibilityCondition::Always => Some(Vec::new()),
+        VisibilityCondition::FacesEye { point, normal } => Some(vec![(
+            [point[0], point[1], point[2], normal[0], normal[1], normal[2]],
+            false,
+        )]),
+        VisibilityCondition::FacesEyeAll { faces, count, off } => Some(
+            faces[..usize::from(count)]
+                .iter()
+                .enumerate()
+                .map(|(i, f)| (*f, off >> i & 1 != 0))
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+/// DBG_SORT_FACING prototype: the gate of `faces`, or `None` past four.
+fn gate_of(all: &[([f32; 6], bool)]) -> Option<VisibilityCondition> {
+    match all {
+        [] => Some(VisibilityCondition::Always),
+        [(f, false)] => Some(VisibilityCondition::FacesEye {
+            point: [f[0], f[1], f[2]],
+            normal: [f[3], f[4], f[5]],
+        }),
+        _ if all.len() <= 4 => {
+            let mut faces = [[0.0; 6]; 4];
+            let mut off = 0u8;
+            for (i, (f, o)) in all.iter().enumerate() {
+                faces[i] = *f;
+                if *o {
+                    off |= 1 << i;
+                }
+            }
+            Some(VisibilityCondition::FacesEyeAll {
+                faces,
+                count: u8::try_from(all.len()).unwrap_or(4),
+                off,
+            })
+        }
+        _ => None,
+    }
+}
+
+/// DBG_SORT_FACING prototype: a gate open while both `a` and `b` are, or `None` when they
+/// are not both facing gates or hold more than four faces together.
+fn combine(a: VisibilityCondition, b: VisibilityCondition) -> Option<VisibilityCondition> {
+    let mut all = gate_faces(a)?;
+    all.extend(gate_faces(b)?);
+    gate_of(&all)
+}
