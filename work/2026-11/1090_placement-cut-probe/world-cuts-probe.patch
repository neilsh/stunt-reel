+/// Probe (#1090): whether any placement's triangles lie in the world's shared `WORLD_BASE`
+/// or `WORLD_DECAL` slice, which a frame stream would have to cut out of it.
+pub fn probe_world_cuts(scene: &FilmScene) -> Result<(), String> {
+    let w = scene.world().ok_or("no world")?;
+    let placements = WorldPlacements::new(w);
+    let run = |node: Option<(NodeId, ArenaSpan)>| node.map(|(_, r)| (r.start, r.end));
+    let (base_run, decal_run) = (run(placements.base), run(placements.decal));
+    let inside = |span: ArenaSpan, run: Option<(u32, u32)>| {
+        run.is_some_and(|(lo, hi)| span.start >= lo && span.end <= hi)
+    };
+    let (mut with_mesh, mut base_spans, mut decal_spans) = (0u64, 0u64, 0u64);
+    let (mut base_in, mut decal_in, mut base_idx, mut decal_idx) = (0u64, 0u64, 0u64, 0u64);
+    let mut owned = 0u64;
+    for s in placements.spans.iter().flatten() {
+        with_mesh += 1;
+        if !s.base.is_empty() {
+            base_spans += 1;
+            base_idx += u64::from(s.base.end - s.base.start);
+            base_in += u64::from(inside(s.base, base_run));
+        }
+        if !s.decal.is_empty() {
+            decal_spans += 1;
+            decal_idx += u64::from(s.decal.end - s.decal.start);
+            decal_in += u64::from(inside(s.decal, decal_run));
+        }
+        owned += u64::from(!s.nodes.is_empty());
+    }
+    eprintln!(
+        "[probe1090] nodes {} vertices {} indices {} records {} with_mesh {} base_run {:?} decal_run {:?}          base_spans {} base_in_run {} base_indices {} decal_spans {} decal_in_run {} decal_indices {}          with_own_nodes {}",
+        w.ir.nodes.len(),
+        w.ir.vertices.len(),
+        w.ir.indices.len(),
+        placements.spans.len(),
+        with_mesh,
+        base_run,
+        decal_run,
+        base_spans,
+        base_in,
+        base_idx,
+        decal_spans,
+        decal_in,
+        decal_idx,
+        owned,
+    );
+    Ok(())
+}
