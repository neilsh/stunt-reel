+
+fn ms(ns: u64) -> f64 {
+    ns as f64 / 1_000_000.0
+}
+
+fn parse_probe_workers() -> Result<Option<usize>, String> {
+    let Ok(val) = std::env::var("DBG_PROBE_WORKERS") else {
+        return Ok(None);
+    };
+    if val.is_empty() {
+        return Ok(None);
+    }
+    let n = val
+        .parse::<usize>()
+        .map_err(|e| format!("invalid DBG_PROBE_WORKERS={val:?}: {e}"))?;
+    if n == 0 {
+        return Err("DBG_PROBE_WORKERS must be >= 1".to_string());
+    }
+    Ok(Some(n))
+}
