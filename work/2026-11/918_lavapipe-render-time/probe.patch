+/// Runs a CPU-only whole-film draw and relight scan across `ticks` (`(film_tick, eval_tick)`),
+/// writing one line per tick to `out_path`.
+///
+/// # Errors
+/// Returns an error string if creating or writing `out_path` fails.
+pub fn cpu_scan_film(
+    scene: &FilmScene,
+    ticks: &[(usize, f32)],
+    height: u32,
+    viewport_rows: Option<u32>,
+    out_path: &std::path::Path,
