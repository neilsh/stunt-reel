+                && let Some(bounds) = model.root_bounds
+            {
+                let eye_rel = eye_relative_matrix(eye, &prop.world_matrix);
+                if !crate::mesh::frustum_keeps(rotation_proj * Mat4::from_cols_array(&eye_rel), bounds)
+                {
+                    continue;
+                }
