+    /// Returns a cloned vector of recorded per-frame draw counts.
+    #[must_use]
+    pub fn draw_frames() -> Vec<DrawFrameCounts> {
+        let Some(mutex) = DRAW_FRAMES.get() else {
+            return Vec::new();
+        };
+        mutex.lock().map_or_else(|_| Vec::new(), |g| g.clone())
+    }
+
+    /// Writes `DRAWFRAME` lines for `frames` to `path`.
+    ///
+    /// # Errors
+    /// Returns an error string if creating or writing `path` fails.
+    pub fn write_draw_lines(path: &Path, frames: &[DrawFrameCounts], reach_total: usize) -> Result<(), String> {
+        if let Some(parent) = path.parent()
+            && !parent.as_os_str().is_empty()
+        {
+            std::fs::create_dir_all(parent)
+                .map_err(|e| format!("create dir {}: {e}", parent.display()))?;
+        }
+        let file = OpenOptions::new()
+            .create(true)
+            .write(true)
+            .truncate(true)
+            .open(path)
+            .map_err(|e| format!("open {}: {e}", path.display()))?;
+        let mut writer = std::io::BufWriter::new(file);
+        writeln!(writer, "# world_reach_total={reach_total}")
+            .map_err(|e| format!("write {}: {e}", path.display()))?;
+        for f in frames {
+            writeln!(
+                writer,
+                "DRAWFRAME tick={} ground_fill={} ground_edge={} base_fill={} base_edge={} decal_fill={} decal_edge={} view_facing={} actor_unlit={} actor_lit={} shadow={} sprite={} total={} reach_frustum={} reach_kept={}",
+                f.tick,
+                f.ground_fill,
+                f.ground_edge,
+                f.base_fill,
+                f.base_edge,
+                f.decal_fill,
+                f.decal_edge,
+                f.view_facing,
+                f.actor_unlit,
+                f.actor_lit,
+                f.shadow,
+                f.sprite,
+                f.total_draws(),
+                f.reach_frustum,
+                f.reach_kept,
+            )
+            .map_err(|e| format!("write {}: {e}", path.display()))?;
+        }
+        writer
+            .flush()
+            .map_err(|e| format!("flush {}: {e}", path.display()))
+    }
+}
