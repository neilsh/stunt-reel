+    /// DEBUG (not committed): appends one line per drawn placement past PLAYONE's `0x1B28` cut.
+    fn dbg_scale_cut_dump(&self, path: &str, tick: f32, camera: &CameraTransform) {
+        use std::io::Write as _;
+        let Some(world) = &self.world else { return };
+        let gates = crate::world::DBG_REC_GATES.lock().map(|g| g.clone()).unwrap_or_default();
+        let (_, lens_shift) = camera.lod_lens_words();
+        let zoom = camera.lens_zoom();
+        let eye = camera.eye;
+        let fwd = {
+            let f = [camera.target[0] - eye[0], camera.target[1] - eye[1], camera.target[2] - eye[2]];
+            let l = (f[0] * f[0] + f[1] * f[1] + f[2] * f[2]).sqrt().max(1e-9);
+            [f[0] / l, f[1] / l, f[2] / l]
+        };
+        let mut out = String::new();
+        let mut drawn = 0usize;
+        for (i, r) in world.placements.records.iter().enumerate() {
+            if !r.drawn {
+                continue;
+            }
+            let Some((g, k, radius)) = gates.get(i) else { continue };
+            let (k, radius) = (*k, *radius);
+            if k < 0 {
+                continue;
+            }
+            let gates_hold = g.iter().all(|gate| lod_gate_holds(camera, gate));
+            if !gates_hold {
+                continue;
+            }
+            drawn += 1;
+            let rel = [r.position[0] - eye[0], r.position[1] - eye[1], r.position[2] - eye[2]];
+            let m = rel.iter().fold(0.0f32, |a, v| a.max(v.abs()));
+            let exp = 22 + i32::from(lens_shift) - k;
+            let cut_m = 2f64.powi(exp);
+            let past = f64::from(m.floor()) >= cut_m;
+            let depth = rel[0] * fwd[0] + rel[1] * fwd[1] + rel[2] * fwd[2];
+            let dist = (rel[0] * rel[0] + rel[1] * rel[1] + rel[2] * rel[2]).sqrt();
+            let lateral = (dist * dist - depth * depth).max(0.0).sqrt();
+            let f = 256.0 * zoom;
+            let rpx = if depth > 0.0 { radius * f / depth } else { f32::INFINITY };
+            // In front and within the 320x185 view's half-diagonal widened by the radius, roll ignored.
+            let in_frame = depth > 0.5
+                && depth < 25_000.0
+                && lateral * f / depth <= (160.0f32).hypot(92.5) + rpx;
+            if past {
+                out.push_str(&format!(
+                    "PAST {tick} {i} {:#06x} k={k} L={lens_shift} m={m:.1} cut={cut_m} depth={depth:.1} r={radius:.3} rpx={rpx:.3} in_frame={in_frame} stand_in={}
+",
+                    r.shape, r.stand_in
+                ));
+            }
+        }
+        out.push_str(&format!("TICK {tick} drawn={drawn} L={lens_shift}
+"));
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = f.write_all(out.as_bytes());
+        }
+    }
