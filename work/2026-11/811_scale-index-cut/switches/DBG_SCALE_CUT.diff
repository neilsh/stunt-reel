+    #[must_use]
+    pub fn scale_cut_keeps(&self, point: [f32; 3], scale_index: u8) -> bool {
+        let (_, shift) = self.lod_lens_words();
+        let largest = (0..3).fold(0.0f32, |a, i| a.max((point[i] - self.eye[i]).abs()));
