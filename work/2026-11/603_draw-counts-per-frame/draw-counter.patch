+use crate::mesh::{GpuMeshSlice, GpuModel, coalesce_base_meshes};
@@ -488,0 +489,64 @@ impl SceneRenderer {
+        // TEMP #603 draw counter (uncommitted): one line per frame to stderr.
+        {
+            let edges = |slices: &[GpuMeshSlice]| slices.iter().filter(|m| m.edge_count > 0).count();
+            let (mut ground_fill, mut ground_edge) = (0, 0);
+            let (mut base_fill, mut base_edge) = (0, 0);
+            let (mut decal_fill, mut decal_edge) = (0, 0);
+            let (mut prop_fill, mut merged_fill, mut merged_edge) = (0, 0, 0);
+            let (mut world_chunks, mut world_vertices, mut world_indices) = (0, 0, 0);
+            let (mut base_offsets, mut contiguous_ne, mut ascending) = (0, 0, 0);
+            for draw in &self.prepared {
+                match draw.target {
+                    Target::World => {
+                        ground_fill += draw.ground.len();
+                        ground_edge += edges(&draw.ground);
+                        base_fill += draw.base.len();
+                        base_edge += edges(&draw.base);
+                        decal_fill += draw.decals.len();
+                        decal_edge += edges(&draw.decals);
+                        if let Some(world) = &self.world {
+                            world_chunks = world.chunks.len();
+                            world_vertices = world.vertex_count;
+                            world_indices = world.index_count;
+                        }
+                        let mut offsets: Vec<i32> =
+                            draw.base.iter().map(|m| m.vertex_offset).collect();
+                        offsets.sort_unstable();
+                        offsets.dedup();
+                        base_offsets = offsets.len();
+                        for pair in draw.base.windows(2) {
+                            if pair[0].index_offset + pair[0].index_count == pair[1].index_offset {
+                                ascending += 1;
+                                if pair[0].chunk != pair[1].chunk
+                                    || pair[0].vertex_offset != pair[1].vertex_offset
+                                {
+                                    contiguous_ne += 1;
+                                }
+                            }
+                        }
+                    }
+                    Target::Shape { .. } | Target::Image { .. } => {
+                        prop_fill += draw.base.len() + draw.decals.len();
+                    }
+                }
+                let merged = coalesce_base_meshes(draw.base.clone());
+                merged_fill += draw.base.len() - merged.len();
+                merged_edge += edges(&draw.base) - edges(&merged);
+            }
+            let line = format!(
+                "DRAWFRAME ground_fill={ground_fill} ground_edge={ground_edge} world_base_fill={base_fill} world_base_edge={base_edge} world_decal_fill={decal_fill} world_decal_edge={decal_edge} prop_fill={prop_fill} merged_fill={merged_fill} merged_edge={merged_edge} world_chunks={world_chunks} world_vertices={world_vertices} world_indices={world_indices} base_offsets={base_offsets} contiguous_ne={contiguous_ne} ascending={ascending}"
+            );
+            match std::env::var("DBG_DRAWCOUNT_FILE") {
+                Ok(path) => {
+                    use std::io::Write as _;
+                    if let Ok(mut file) = std::fs::OpenOptions::new()
+                        .create(true)
+                        .append(true)
+                        .open(path)
+                    {
+                        writeln!(file, "{line}").expect("write the draw count");
+                    }
+                }
+                Err(_) => eprintln!("{line}"),
+            }
+        }
