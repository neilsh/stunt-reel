diff --git a/crates/stunt-render/src/mesh.rs b/crates/stunt-render/src/mesh.rs
index f15e4545..cb579f06 100644
--- a/crates/stunt-render/src/mesh.rs
+++ b/crates/stunt-render/src/mesh.rs
@@ -303,0 +304,50 @@ impl GpuModel {
+/// Merges runs of adjacent base slices that one chunk's buffers continue, so the base pass
+/// issues one `draw_indexed` for the run instead of one per slice; its triangles stay in the
+/// same order, so a depth tie resolves as before.
+///
+/// A slice joins the run behind it when it shares that run's chunk and base vertex, its first
+/// index follows the run's last, and its outline continues the run's when both draw one
+/// ([ADR 0046](../../../docs/adr/0046-coplanar-decals-are-drawn-in-an-ordered-pass.md)).
+/// Ground and decal slices are never merged: each fills, then outlines, before the next one
+/// draws, so a later slice covers an earlier one's outline (`[I5]`).
+pub(crate) fn coalesce_base_meshes(slices: Vec<GpuMeshSlice>) -> Vec<GpuMeshSlice> {
+    let mut out: Vec<GpuMeshSlice> = Vec::with_capacity(slices.len());
+    for slice in slices {
+        match out.last_mut() {
+            Some(last) if continues(*last, slice) => *last = joined(*last, slice),
+            _ => out.push(slice),
+        }
+    }
+    out
+}
+
+/// Whether `next` can join the run ending at `last`.
+fn continues(last: GpuMeshSlice, next: GpuMeshSlice) -> bool {
+    !last.is_decal
+        && !next.is_decal
+        && last.chunk == next.chunk
+        && last.vertex_offset == next.vertex_offset
+        && last.index_offset + last.index_count == next.index_offset
+        && (last.edge_count == 0
+            || next.edge_count == 0
+            || last.edge_offset + last.edge_count == next.edge_offset)
+}
+
+/// The run of `last` with `next` appended: both index ranges, and the outlines they draw.
+fn joined(last: GpuMeshSlice, next: GpuMeshSlice) -> GpuMeshSlice {
+    let (edge_offset, edge_count) = match (last.edge_count, next.edge_count) {
+        (0, _) => (next.edge_offset, next.edge_count),
+        (_, 0) => (last.edge_offset, last.edge_count),
+        _ => (last.edge_offset, last.edge_count + next.edge_count),
+    };
+    GpuMeshSlice {
+        chunk: last.chunk,
+        vertex_offset: last.vertex_offset,
+        index_offset: last.index_offset,
+        index_count: last.index_count + next.index_count,
+        is_decal: false,
+        edge_offset,
+        edge_count,
+    }
+}
+
diff --git a/crates/stunt-render/src/scene_renderer.rs b/crates/stunt-render/src/scene_renderer.rs
