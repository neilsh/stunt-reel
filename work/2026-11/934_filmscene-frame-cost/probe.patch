+    /// `#934` probe: the `view_facing` collection with the shape filter hoisted to once per
+    /// scene and the camera's gate words computed once per frame, same output.
+    fn view_facing_fast(
+        &self,
+        camera: &CameraTransform,
+        heading: f32,
+        eye: [f32; 3],
+    ) -> Vec<ActorDraw> {
+        use crate::contracts::VisibilityCondition;
+        static SHAPED: std::sync::OnceLock<Vec<bool>> = std::sync::OnceLock::new();
+        let Some(world) = self.world.as_ref() else {
+            return Vec::new();
+        };
+        let shaped = SHAPED.get_or_init(|| {
+            world
+                .view_facing
+                .iter()
+                .map(|p| self.shapes.contains_key(&p.shape))
+                .collect()
+        });
+        let (mantissa, shift) = camera.lod_lens_words();
+        let forward = [
+            camera.target[0] - camera.eye[0],
+            camera.target[1] - camera.eye[1],
+            camera.target[2] - camera.eye[2],
+        ];
+        let len =
+            (forward[0] * forward[0] + forward[1] * forward[1] + forward[2] * forward[2]).sqrt();
+        let divisor = f32::from(2u16 << shift);
+        let ce = camera.eye;
+        let lod = |point: [f32; 3], ext: i32, splitdist: i32| -> bool {
+            if len <= 0.0 {
+                return true;
+            }
+            let depth = ((point[0] - ce[0]) * forward[0]
+                + (point[1] - ce[1]) * forward[1]
+                + (point[2] - ce[2]) * forward[2])
+                / len;
+            let depth = (depth / divisor).floor();
+            let half = i64::from(ext >> 1);
+            let split = i64::from(splitdist);
+            let threshold = if split < half {
+                split
+            } else {
+                half + (((split - half) * i64::from(mantissa)) >> 16)
+            };
+            depth <= threshold as f32
+        };
+        let reach = |point: [f32; 3], scale_index: u8| -> bool {
+            let largest = point
+                .iter()
+                .zip(&ce)
+                .map(|(p, e)| (p - e).abs())
+                .fold(0.0f32, f32::max);
+            let high = largest.clamp(0.0, 65535.0) as u16;
+            let s = 17u32.saturating_sub(high.leading_zeros());
+            let gap = (u32::from(scale_index).saturating_add(s)).saturating_sub(16);
+            gap <= u32::from(shift).saturating_add(7)
+        };
+        let holds = |gate: &VisibilityCondition| match *gate {
+            VisibilityCondition::LodBranch {
+                point,
+                ext,
+                splitdist,
+                near,
+            } => lod(point, ext, splitdist) == near,
+            VisibilityCondition::ScaleReach { point, scale_index } => reach(point, scale_index),
+            _ => true,
+        };
+        world
+            .view_facing
+            .iter()
+            .zip(shaped)
+            .filter(|&(_, &ok)| ok)
+            .map(|(p, _)| p)
+            .filter(|p| p.gates.iter().all(holds))
+            .map(|p| ActorDraw {
+                shape_id: p.shape,
+                world_matrix: facing_matrix(heading, p.position),
+                state_mask: 0,
+                distance: distance(eye, p.position),
+                shadow_matrix: None,
+                shadow_only: false,
+                light: self.relit.light(),
+                bank: AngleBank::REST,
+            })
+            .collect()
+    }
+
+    /// `#934` probe: the `view_facing` collection as three timed passes, same output.
+    fn view_facing_split(
+        &self,
+        camera: &CameraTransform,
+        heading: f32,
+        eye: [f32; 3],
+    ) -> Vec<ActorDraw> {
+        use frame_probe as fp;
+        let t = std::time::Instant::now();
+        let shaped: Vec<&crate::world::FacingProp> = self
+            .world
+            .iter()
+            .flat_map(|w| &w.view_facing)
+            .filter(|p| self.shapes.contains_key(&p.shape))
+            .collect();
+        fp::since(fp::VF_SHAPE, t);
+        let t = std::time::Instant::now();
+        let mut evaluated = 0u64;
+        let mut gates = 0u64;
+        let kept: Vec<&crate::world::FacingProp> = shaped
+            .into_iter()
+            .filter(|p| {
+                gates += p.gates.len() as u64;
+                p.gates.iter().all(|gate| {
+                    evaluated += 1;
+                    lod_gate_holds(camera, gate)
+                })
+            })
+            .collect();
+        fp::since(fp::VF_GATES, t);
+        fp::add(fp::VF_GATES_EVALUATED, evaluated);
+        fp::add(fp::VF_GATES_TOTAL, gates);
+        let t = std::time::Instant::now();
+        let out = kept
+            .into_iter()
+            .map(|p| ActorDraw {
+                shape_id: p.shape,
+                world_matrix: facing_matrix(heading, p.position),
+                state_mask: 0,
+                distance: distance(eye, p.position),
+                shadow_matrix: None,
+                shadow_only: false,
+                light: self.relit.light(),
+                bank: AngleBank::REST,
+            })
+            .collect();
+        fp::since(fp::VF_BUILD, t);
+        out
+    }
