+#[expect(
+    clippy::too_many_arguments,
+    reason = "temporary #918 phase report summary"
+)]
+fn print_probe_report(
+    frames: usize,
+    build_scene_ns: u64,
+    renderer_open_ns: u64,
+    release_world_ns: u64,
+    scene_frame_ns: u64,
+    loop_wall_ns: u64,
+    drop_renderer_ns: u64,
+    journal_finish_ns: u64,
+    end_to_end_ns: u64,
+    rsnap: stunt_render::probe::RenderSnapshot,
+    ssnap: stunt_score::probe::ScoreSnapshot,
+) {
+    let stats = read_process_stats();
+    println!(
+        "PROBE_SUMMARY frames={frames} fif={} plane_only={} cull_vf={} skip_apex={} ring_lit={} build_ms={:.3} open_ms={:.3} release_ms={:.3} loop_ms={:.3} drop_ms={:.3} finish_ms={:.3} end_to_end_ms={:.3} cpu_s={:.6} rss_mib={:.2} peak_rss_mib={:.2} peak_private_mib={:.2}",
+        stunt_render::probe::frames_in_flight(),
+        u8::from(stunt_render::probe::plane_only()),
+        u8::from(stunt_render::probe::cull_view_facing()),
+        u8::from(stunt_render::probe::skip_apex_rewrite()),
+        u8::from(stunt_render::probe::ring_lit()),
+        ms(build_scene_ns),
+        ms(renderer_open_ns),
+        ms(release_world_ns),
+        ms(loop_wall_ns),
+        ms(drop_renderer_ns),
+        ms(journal_finish_ns),
+        ms(end_to_end_ns),
+        stats.cpu_seconds,
+        stats.rss_bytes as f64 / (1024.0 * 1024.0),
+        stats.peak_rss_bytes as f64 / (1024.0 * 1024.0),
+        stats.peak_private_bytes as f64 / (1024.0 * 1024.0),
+    );
+    println!(
+        "PROBE_STARTUP adapter_device_ms={:.3} pipelines_ms={:.3} scene_upload_ms={:.3} world_chunks={} world_reach_total={}",
+        ms(rsnap.adapter_device_ns),
+        ms(rsnap.pipelines_ns),
+        ms(rsnap.scene_upload_ns),
+        rsnap.world_chunks,
+        rsnap.world_reach_total,
+    );
+    println!(
+        "PROBE_PHASES scene_frame_ms={:.3} palette_lut_ms={:.3} prepare_total_ms={:.3} prepare_camera_ms={:.3} prepare_world_ms={:.3} prepare_view_facing_ms={:.3} prepare_relight_decode_ms={:.3} prepare_relight_upload_ms={:.3} prepare_actors_other_ms={:.3} prepare_sprites_place_ms={:.3} prepare_uniforms_upload_ms={:.3} pass_encode_submit_ms={:.3} scene_draw_ms={:.3} queue_submit_ms={:.3} poll_color_ms={:.3} poll_plane_ms={:.3} readback_copy_ms={:.3} credits_overlay_ms={:.3} journal_write_ms={:.3} check_derivable_ms={:.3} u16_bytes_ms={:.3} preview_png_ms={:.3} zstd_chunk_push_ms={:.3} zstd_chunk_finish_ms={:.3} score_journal_finish_ms={:.3}",
+        ms(scene_frame_ns),
+        ms(rsnap.palette_lut_ns),
+        ms(rsnap.prepare_total_ns),
+        ms(rsnap.prepare_camera_ns),
+        ms(rsnap.prepare_world_ns),
+        ms(rsnap.prepare_view_facing_ns),
+        ms(rsnap.prepare_relight_decode_ns),
+        ms(rsnap.prepare_relight_upload_ns),
+        ms(rsnap.prepare_actors_other_ns),
+        ms(rsnap.prepare_sprites_place_ns),
+        ms(rsnap.prepare_uniforms_upload_ns),
+        ms(rsnap.pass_encode_submit_ns),
+        ms(rsnap.scene_draw_ns),
+        ms(rsnap.queue_submit_ns),
+        ms(rsnap.poll_color_ns),
+        ms(rsnap.poll_plane_ns),
+        ms(rsnap.readback_copy_ns),
+        ms(rsnap.credits_overlay_ns),
+        ms(ssnap.journal_write_ns),
+        ms(ssnap.check_derivable_ns),
+        ms(ssnap.u16_bytes_ns),
+        ms(ssnap.preview_png_ns),
+        ms(ssnap.zstd_chunk_push_ns),
+        ms(ssnap.zstd_chunk_finish_ns),
