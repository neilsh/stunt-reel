+                decals: untag(&decals),
+                shadow: false,
+            });
+            world_slices = Some((prepared.len() - 1, base, decals));
+        }
+
+        for prop in &frame.view_facing {
+            let Some(model) = shapes.get(&prop.shape_id) else {
+                continue;
+            };
+            let eye_rel = eye_relative_matrix(eye, &prop.world_matrix);
+            if !model.in_frustum(
+                rotation_proj * Mat4::from_cols_array(&eye_rel),
+                camera_uniform.disc_depth_scale,
+            ) {
+                continue;
+            }
+            let to_model = Mat4::from_cols_array(&prop.world_matrix).inverse();
+            let local_eye = to_model.transform_point3(eye);
+            let view = model_view(&to_model, &frame);
+            let (base, decals) = model.collect_visible_meshes(
+                prop.state_mask,
+                prop.distance,
+                local_eye,
+                Some(&view),
+            );
+            if base.is_empty() && decals.is_empty() {
+                continue;
+            }
+            prepared.push(PreparedDraw {
+                target: Target::Shape {
+                    shape_id: prop.shape_id,
+                    uniform: 0,
+                },
+                kind: DrawKind::ViewFacing,
+                ground: Vec::new(),
+                base,
+                decals,
+                shadow: false,
+            });
+        }
+
+        let back = controller.compute_view_matrix().row(2).truncate();
+        let view_depth = |m: &[f32; 16]| {
+            let at = Mat4::from_cols_array(m).w_axis.truncate();
+            (eye - at).dot(back)
+        };
+        let actor_depths: Vec<f32> = frame
+            .actors
+            .iter()
+            .map(|a| view_depth(&a.world_matrix))
+            .collect();
+        let mut actor_draws = Vec::new();
+        lit_slots.resize_with(frame.actors.len(), || None);
+        let mut relight_keep = 0usize;
+        let mut relight_rewrite = 0usize;
+        let mut relight_upload = 0usize;
+
+        for (slot, actor) in frame.actors.iter().enumerate() {
+            let needs_relight = actor.light != relit.light() || actor.bank != AngleBank::REST;
+            let mut is_lit = false;
+            if needs_relight && let Some(entry) = lit_slots.get_mut(slot) {
+                let pose = (actor.light, actor.bank);
+                if entry
+                    .as_ref()
+                    .is_some_and(|l| l.layout.shape_id == actor.shape_id && l.pose == pose)
+                {
+                    relight_keep += 1;
+                    is_lit = true;
+                } else if let Some(ir) = relit.decode(actor.shape_id, pose.0, pose.1) {
+                    let shape = outlined(&ir);
+                    let mut reused = false;
+                    if let Some(prev) = entry.as_mut() {
+                        match prev.layout.refresh(actor.shape_id, &shape.ir) {
+                            Refresh::Keep => {
+                                prev.pose = pose;
+                                relight_keep += 1;
+                                reused = true;
+                            }
+                            Refresh::Rewrite => {
+                                prev.pose = pose;
+                                prev.layout.vertices.clone_from(&shape.ir.vertices);
+                                relight_rewrite += 1;
+                                reused = true;
+                            }
+                            Refresh::Upload => {}
+                        }
+                    }
+                    if !reused {
+                        let model = GpuModel::from_outlined_cpu(&shape);
+                        *entry = Some(CpuLitSlot {
+                            pose,
+                            layout: LitLayout::of(actor.shape_id, &shape.ir),
+                            model,
+                        });
+                        relight_upload += 1;
+                    }
+                    is_lit = true;
+                } else {
+                    *entry = None;
+                }
+            }
+            let model = if is_lit {
+                lit_slots
+                    .get(slot)
+                    .and_then(Option::as_ref)
+                    .map(|l| &l.model)
+            } else {
+                shapes.get(&actor.shape_id)
+            };
+            let Some(model) = model else {
+                continue;
+            };
+            let to_model = Mat4::from_cols_array(&actor.world_matrix).inverse();
+            let local_eye = to_model.transform_point3(eye);
+            let view = model_view(&to_model, &frame);
+            let (base, decals) = model.collect_visible_meshes(
+                actor.state_mask,
+                actor.distance,
+                local_eye,
+                Some(&view),
+            );
+            if base.is_empty() && decals.is_empty() {
+                continue;
+            }
+            let target = if is_lit {
+                Target::Lit {
+                    actor: slot,
+                    uniform: 0,
+                }
+            } else {
+                Target::Shape {
+                    shape_id: actor.shape_id,
+                    uniform: 0,
+                }
+            };
+            if actor.shadow_matrix.is_some() {
+                let shadow = base.iter().chain(&decals).copied().collect();
+                prepared.push(PreparedDraw {
+                    target,
+                    kind: DrawKind::ActorShadow,
+                    ground: Vec::new(),
+                    base: Vec::new(),
+                    decals: shadow,
+                    shadow: true,
+                });
+            }
+            if actor.shadow_only {
+                continue;
+            }
+            prepared.push(PreparedDraw {
+                target,
+                kind: if is_lit {
+                    DrawKind::ActorLit
+                } else {
+                    DrawKind::ActorUnlit
+                },
+                ground: Vec::new(),
+                base,
+                decals,
+                shadow: false,
+            });
+            if let Some(&depth) = actor_depths.get(slot) {
+                actor_draws.push((prepared.len() - 1, depth));
+            }
+        }
+
+        let mut placed = Vec::new();
+        for sprite in &frame.sprites {
+            let Some(model) = images.get(&sprite.image_id) else {
+                continue;
+            };
+            let (base, decals) = model.collect_visible_meshes(0, 0.0, eye, None);
+            let draw = PreparedDraw {
+                target: Target::Image {
+                    image_id: sprite.image_id,
+                    uniform: 0,
+                },
+                kind: DrawKind::Sprite,
+                ground: Vec::new(),
+                base,
+                decals,
+                shadow: false,
+            };
+            match (&sprite.after, actor_depths.get(sprite.actor)) {
+                (Some(after), Some(&depth)) => {
+                    let distance = (Vec3::from_array(sprite.centre) - eye).length();
+                    placed.push((after.as_slice(), depth, distance, draw));
+                }
+                _ => prepared.push(draw),
+            }
+        }
+        // Mirror SceneRenderer::place_sprites without needing &mut self.
+        if !placed.is_empty() {
+            placed.sort_by(|a, b| b.0.len().cmp(&a.0.len()).then(b.2.total_cmp(&a.2)));
+            let mut rank = vec![0usize; placements.spans.len()];
+            for (after, _, _, _) in &placed {
+                for &record in *after {
+                    if let Some(r) = rank.get_mut(record as usize) {
+                        *r += 1;
+                    }
+                }
+            }
+            let cut = world_slices.zip(world.as_ref()).and_then(|((at, base, decals), model)| {
+                let mut base_steps = vec![Vec::new(); placed.len()];
+                let mut decal_steps = vec![Vec::new(); placed.len()];
+                let cut = |node, start, end| model.cut(node, start, end);
+                let base = placements.split(base, &rank, false, &mut base_steps, cut)?;
+                let decals = placements.split(decals, &rank, true, &mut decal_steps, cut)?;
+                Some((at, base, decals, base_steps.into_iter().zip(decal_steps)))
+            });
+            if let Some((at, base, decals, props)) = cut
+                && let Some(w_draw) = prepared.get_mut(at)
+            {
+                w_draw.base = base;
+                w_draw.decals = decals;
+                let target = w_draw.target;
+                let depths: Vec<f32> = placed.iter().map(|&(_, depth, _, _)| depth).collect();
+                let mut step_of: Vec<Option<usize>> = vec![None; prepared.len()];
+                for &(index, depth) in &actor_draws {
+                    if let Some(slot) = step_of.get_mut(index) {
+                        *slot = depths.iter().rposition(|&sprite| depth < sprite);
+                    }
+                }
+                let mut moved: Vec<Vec<PreparedDraw>> =
+                    std::iter::repeat_with(Vec::new).take(placed.len()).collect();
+                let mut kept = Vec::with_capacity(prepared.len());
+                for (draw, step) in prepared.drain(..).zip(step_of) {
+                    match step.and_then(|s| moved.get_mut(s)) {
+                        Some(step) => step.push(draw),
+                        None => kept.push(draw),
+                    }
+                }
+                prepared = kept;
+                for (((_, _, _, sprite), (base, decals)), actors) in
+                    placed.into_iter().zip(props).zip(moved)
+                {
+                    steps.push(WalkStep {
+                        sprites: vec![sprite],
+                        props: PreparedDraw {
+                            target,
+                            kind: DrawKind::World,
+                            ground: Vec::new(),
+                            base,
+                            decals,
+                            shadow: false,
+                        },
+                        actors,
+                    });
+                }
+            } else {
+                prepared.extend(placed.into_iter().map(|(_, _, _, draw)| draw));
+            }
+        }
+
+        #[expect(
+            clippy::cast_possible_truncation,
+            clippy::cast_sign_loss,
+            reason = "integer frame tick from headless playback"
+        )]
+        let mut counts = crate::probe::DrawFrameCounts {
+            tick: frame.tick as u32,
+            reach_frustum,
+            reach_kept,
+            ..crate::probe::DrawFrameCounts::default()
+        };
+        if let Some(w) = prepared.iter().find(|d| matches!(d.target, Target::World { .. }) && !d.ground.is_empty()) {
+            counts.ground_fill += w.ground.len();
+            counts.ground_edge += w.ground.iter().filter(|m| m.edge_count > 0).count();
+        }
+        let mut count_draw = |draw: &PreparedDraw, decal_pass: bool| {
+            let meshes = if decal_pass { &draw.decals } else { &draw.base };
+            if meshes.is_empty() {
+                return;
+            }
+            if matches!(draw.target, Target::World { .. }) {
+                let edges = meshes.iter().filter(|m| m.edge_count > 0).count();
+                if decal_pass {
+                    counts.decal_fill += meshes.len();
+                    counts.decal_edge += edges;
+                } else {
+                    counts.base_fill += meshes.len();
+                    counts.base_edge += edges;
+                }
+            } else {
+                add_non_world_draws(&mut counts, draw.kind, meshes.len());
+            }
+        };
+        for decal_pass in [false, true] {
+            for draw in &prepared {
+                count_draw(draw, decal_pass);
+            }
+        }
+        for step in &steps {
+            for sprite in &step.sprites {
+                count_draw(sprite, false);
+            }
+            for decal_pass in [false, true] {
+                for draw in std::iter::once(&step.props).chain(&step.actors) {
+                    count_draw(draw, decal_pass);
+                }
+            }
+        }
+
+        writeln!(
+            writer,
+            "SCAN film_tick={} eval_tick={} ground_fill={} ground_edge={} base_fill={} base_edge={} decal_fill={} decal_edge={} view_facing={} actor_unlit={} actor_lit={} shadow={} sprite={} total={} reach_frustum={} reach_kept={} relight_keep={} relight_rewrite={} relight_upload={}",
+            film_tick,
+            counts.tick,
+            counts.ground_fill,
+            counts.ground_edge,
+            counts.base_fill,
+            counts.base_edge,
+            counts.decal_fill,
+            counts.decal_edge,
+            counts.view_facing,
+            counts.actor_unlit,
+            counts.actor_lit,
+            counts.shadow,
+            counts.sprite,
+            counts.total_draws(),
+            counts.reach_frustum,
+            counts.reach_kept,
+            relight_keep,
+            relight_rewrite,
+            relight_upload,
+        )
+        .map_err(|e| format!("write {}: {e}", out_path.display()))?;
+    }
+    writer
+        .flush()
+        .map_err(|e| format!("flush {}: {e}", out_path.display()))
+}
