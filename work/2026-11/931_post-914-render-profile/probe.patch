+#[expect(
+    clippy::too_many_arguments,
+    reason = "temporary #918 multi-worker benchmark harness"
+)]
+fn run_probe_workers(
+    config: &CliConfig,
+    scene: FilmScene,
+    film: FilmId,
+    playback: &Playback,
+    offscreen: Offscreen,
+    options: stunt_render::RenderOptions,
+    workers: usize,
+    process_start: std::time::Instant,
+    build_scene_ns: u64,
+) -> Result<(), String> {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::{Barrier, Mutex, RwLock};
+
+    let out_dir = config
+        .out_dir
+        .as_ref()
+        .ok_or_else(|| "DBG_PROBE_WORKERS requires --out-dir".to_string())?;
+    let samples = playback.samples();
+    if !samples.len().is_multiple_of(workers) {
+        return Err(format!(
+            "DBG_PROBE_WORKERS={workers} does not evenly divide {} samples",
+            samples.len()
+        ));
+    }
+    let chunk_size = samples.len() / workers;
+    let geometry = Geometry {
+        width: config.width,
+        height: config.height,
+        viewport_rows: config.viewport_rows,
+    };
+    let scene_lock = RwLock::new(scene);
+    let after_upload = Barrier::new(workers);
+    let after_release = Barrier::new(workers);
+    let after_loop = Barrier::new(workers);
+    let upload_wall_ns = AtomicU64::new(0);
+    let loop_wall_ns = AtomicU64::new(0);
+    let loop_start = Mutex::new(None::<std::time::Instant>);
+    let upload_start = std::time::Instant::now();
+
+    let worker_stats = std::thread::scope(|scope| {
+        let mut handles = Vec::with_capacity(workers);
+        for k in 0..workers {
+            let shard = samples
+                .get(k * chunk_size..(k + 1) * chunk_size)
+                .ok_or_else(|| format!("worker {k} shard out of bounds"))?;
+            let worker_dir = out_dir.join(format!("worker_{k}"));
+            let film_copy = film.clone();
+            let scene_ref = &scene_lock;
+            let b_up = &after_upload;
+            let b_rel = &after_release;
+            let b_loop = &after_loop;
+            let up_ns = &upload_wall_ns;
+            let lp_ns = &loop_wall_ns;
+            let lp_t0 = &loop_start;
+            handles.push(scope.spawn(move || -> Result<(usize, u64, u64, u64, String), String> {
+                fs::create_dir_all(&worker_dir)
+                    .map_err(|e| format!("create {}: {e}", worker_dir.display()))?;
+                let journal = RenderJournal::begin(&worker_dir, film_copy, geometry)
+                    .map_err(|e| e.to_string())?;
+                let mut sink = SampleSink {
+                    out_dir: Some(worker_dir),
+                    video: None,
+                    journal: Some(journal),
+                    written_frames: 0,
+                    written_video_frames: 0,
+                };
+                let slot = PageSlot::default();
+                let t_open = std::time::Instant::now();
+                let mut renderer = {
+                    let guard = scene_ref
+                        .read()
+                        .map_err(|e| format!("scene read lock poisoned: {e}"))?;
+                    Renderer::offscreen(&guard, offscreen, Box::new(slot.clone()), options)
+                        .map_err(|e| format!("worker {k} Renderer::offscreen failed: {e}"))?
+                };
+                let open_ns = dur_ns(t_open.elapsed());
+                b_up.wait();
+                if k == 0 {
+                    scene_ref
+                        .write()
+                        .map_err(|e| format!("scene write lock poisoned: {e}"))?
+                        .release_world_mesh();
+                    up_ns.store(dur_ns(upload_start.elapsed()), Ordering::Relaxed);
+                    if let Ok(mut g) = lp_t0.lock() {
+                        *g = Some(std::time::Instant::now());
+                    }
+                }
+                b_rel.wait();
+                let t_wloop = std::time::Instant::now();
+                {
+                    let guard = scene_ref
+                        .read()
+                        .map_err(|e| format!("scene read lock poisoned: {e}"))?;
+                    let mut pending: VecDeque<(SampleKey, FrameFacts)> = VecDeque::new();
+                    for &(key, tick) in shard {
+                        let frame = guard.frame(capture_tick(tick));
+                        renderer
+                            .submit(&frame, None)
+                            .map_err(|e| format!("worker {k} render {key}: {e}"))?;
+                        pending.push_back((key, FrameFacts::of(&frame)));
+                        write_landed_pages(&slot, &mut pending, &mut sink)?;
+                    }
+                    renderer
+                        .finish()
+                        .map_err(|e| format!("worker {k} finish: {e}"))?;
+                    write_landed_pages(&slot, &mut pending, &mut sink)?;
+                    if !pending.is_empty() {
+                        return Err(format!("worker {k} missed landed pages"));
+                    }
+                }
+                let wloop_ns = dur_ns(t_wloop.elapsed());
+                b_loop.wait();
+                if k == 0
+                    && let Ok(g) = lp_t0.lock()
+                    && let Some(t0) = *g
+                {
+                    lp_ns.store(dur_ns(t0.elapsed()), Ordering::Relaxed);
+                }
+                let adapter = render_adapter(renderer.adapter());
+                let adapter_name = adapter.name.clone();
+                drop(renderer);
+                let t_fin = std::time::Instant::now();
+                sink.finish_journal(adapter)?;
+                let fin_ns = dur_ns(t_fin.elapsed());
+                Ok((k, open_ns, wloop_ns, fin_ns, adapter_name))
+            }));
+        }
+        let mut results = Vec::with_capacity(workers);
+        for handle in handles {
+            let res = handle
+                .join()
+                .map_err(|_| "worker thread panicked".to_string())??;
+            results.push(res);
+        }
+        Ok::<_, String>(results)
+    })?;
+
+    let end_to_end_ns = dur_ns(process_start.elapsed());
+    let stats = read_process_stats();
+    println!(
+        "PROBE_WORKERS workers={workers} frames={} separate_instances={} build_ms={:.3} upload_ms={:.3} loop_ms={:.3} end_to_end_ms={:.3} cpu_s={:.6} rss_mib={:.2} peak_rss_mib={:.2} peak_private_mib={:.2} adapter={:?}",
+        samples.len(),
+        u8::from(stunt_render::probe::separate_instances()),
+        ms(build_scene_ns),
+        ms(upload_wall_ns.load(Ordering::Relaxed)),
+        ms(loop_wall_ns.load(Ordering::Relaxed)),
+        ms(end_to_end_ns),
+        stats.cpu_seconds,
+        stats.rss_bytes as f64 / (1024.0 * 1024.0),
+        stats.peak_rss_bytes as f64 / (1024.0 * 1024.0),
+        stats.peak_private_bytes as f64 / (1024.0 * 1024.0),
+        worker_stats.first().map_or("", |w| w.4.as_str()),
+    );
+    for (k, open_ns, wloop_ns, fin_ns, _) in worker_stats {
+        println!(
+            "PROBE_WORKER id={k} open_ms={:.3} loop_ms={:.3} finish_ms={:.3}",
+            ms(open_ns),
+            ms(wloop_ns),
+            ms(fin_ns)
+        );
+    }
     Ok(())
 }
 
+#[derive(Clone, Copy, Debug, Default)]
+struct ProcessStats {
+    cpu_seconds: f64,
+    rss_bytes: u64,
+    peak_rss_bytes: u64,
+    peak_private_bytes: u64,
+}
+
+fn read_process_stats() -> ProcessStats {
+    if cfg!(windows) {
+        let pid = std::process::id();
+        let script = format!(
+            "$p = Get-Process -Id {pid}; \"$($p.TotalProcessorTime.TotalSeconds) $($p.WorkingSet64) $($p.PeakWorkingSet64) $($p.PeakPagedMemorySize64)\""
+        );
+        if let Ok(output) = std::process::Command::new("powershell")
+            .args(["-NoProfile", "-NonInteractive", "-Command", &script])
+            .output()
+            && output.status.success()
+        {
+            let text = String::from_utf8_lossy(&output.stdout);
+            let mut parts = text.split_whitespace();
+            if let (Some(cpu), Some(ws), Some(pws), Some(priv_b)) = (
+                parts.next().and_then(|s| s.parse::<f64>().ok()),
+                parts.next().and_then(|s| s.parse::<u64>().ok()),
+                parts.next().and_then(|s| s.parse::<u64>().ok()),
+                parts.next().and_then(|s| s.parse::<u64>().ok()),
+            ) {
+                return ProcessStats {
+                    cpu_seconds: cpu,
+                    rss_bytes: ws,
+                    peak_rss_bytes: pws,
+                    peak_private_bytes: priv_b,
+                };
+            }
+        }
+        return ProcessStats::default();
+    }
+    let mut stats = ProcessStats::default();
+    if let Ok(stat) = fs::read_to_string("/proc/self/stat")
+        && let Some((_, rest)) = stat.rsplit_once(')')
+    {
+        let fields: Vec<&str> = rest.split_whitespace().collect();
+        // After ') ', field 0 is state (field 3), so utime (14) -> index 11, stime (15) -> index 12.
+        if let (Some(ut), Some(st)) = (
+            fields.get(11).and_then(|s| s.parse::<u64>().ok()),
+            fields.get(12).and_then(|s| s.parse::<u64>().ok()),
+        ) {
+            stats.cpu_seconds = (ut + st) as f64 / 100.0;
+        }
+    }
+    if let Ok(status) = fs::read_to_string("/proc/self/status") {
+        let kib = |name: &str| -> u64 {
+            status
+                .lines()
+                .find_map(|line| line.strip_prefix(name)?.strip_prefix(':'))
+                .and_then(|rest| rest.trim().strip_suffix("kB"))
+                .and_then(|v| v.trim().parse::<u64>().ok())
+                .unwrap_or(0)
+                * 1024
+        };
+        stats.rss_bytes = kib("VmRSS");
+        stats.peak_rss_bytes = kib("VmHWM");
+    }
+    stats
+}
