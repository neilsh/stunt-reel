+/// Replaces `apex` at each filled disc rim vertex with the disc's unit normal so the vertex
+/// shader can compute the disc's minimum rim depth against the eye plane.
+fn with_disc_normals(ir: &SodModelIr, apex: &[[f32; 3]]) -> Vec<[f32; 3]> {
+    let mut out = apex.to_vec();
+    for tri in ir.indices.as_chunks::<3>().0 {
+        let [a, b, c] = tri.map(|i| i as usize);
+        let (Some(va), Some(vb), Some(vc)) =
+            (ir.vertices.get(a), ir.vertices.get(b), ir.vertices.get(c))
+        else {
+            continue;
+        };
+        let disc =
+            |v: &SodVertex| (v.flags & (VERTEX_FLAG_DISC | VERTEX_FLAG_LINE)) == VERTEX_FLAG_DISC;
+        if !(disc(va) && disc(vb) && disc(vc)) {
+            continue;
+        }
+        let p0 = Vec3::from_array(va.position);
+        let p1 = Vec3::from_array(vb.position);
+        let p2 = Vec3::from_array(vc.position);
+        let normal = (p1 - p0).cross(p2 - p0).normalize_or_zero();
+        if normal.length_squared() > 0.0 {
+            let arr = normal.to_array();
+            for idx in [a, b, c] {
+                if let Some(slot) = out.get_mut(idx) {
+                    *slot = arr;
+                }
+            }
+        }
+    }
+    out
+}
