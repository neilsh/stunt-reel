+
+/// Probe (#920, #1000): a CPU-only model of `ir`, one slice per mesh node, for walking.
+impl GpuModel {
+    pub(crate) fn probe_cpu(ir: &SodModelIr) -> Self {
+        let bounds = node_bounds(ir);
+        let discs = node_discs(ir);
+        let mut meshes = ir.meshes().peekable();
+        let nodes = ir
+            .nodes
+            .iter()
+            .enumerate()
+            .map(|(n, node)| {
+                let slices = meshes
+                    .next_if(|m| std::ptr::eq(m.node, node))
+                    .map(|m| {
+                        vec![GpuMeshSlice {
+                            chunk: 0,
+                            vertex_offset: 0,
+                            index_offset: m.index_offset,
+                            index_count: arena_index(m.indices.len()),
+                            is_decal: m.is_decal(),
+                            edge_offset: 0,
+                            edge_count: 0,
+                        }]
+                    })
+                    .unwrap_or_default();
+                GpuNode {
+                    id: node.id,
+                    name: node.name.clone(),
+                    parent: node.parent,
+                    children: node.children.clone(),
+                    local_matrix: Mat4::from_cols_array(&node.local_matrix),
+                    visibility: node.visibility,
+                    meshes: slices,
+                    bounds: bounds.get(n).copied().flatten(),
+                    discs: discs.get(n).copied().unwrap_or(false),
+                    marks: Vec::new(),
+                }
+            })
+            .collect();
+        Self {
+            name: ir.name.clone(),
+            chunks: Vec::new(),
+            vertex_count: 0,
+            index_count: 0,
+            nodes,
+            root_nodes: ir.root_nodes.clone(),
+            bounds: None,
+            discs: false,
+        }
+    }
+}
+
+/// Probe (#1000): a node's cull box and whether it holds disc rim vertices.
+impl GpuModel {
+    pub(crate) fn probe_node(&self, id: NodeId) -> Option<(NodeBounds, bool)> {
+        let node = self.nodes.get(id.0 as usize)?;
+        Some((node.bounds?, node.discs))
+    }
+}
+
+/// Probe (#920): whether a placement box survives the walk's own cull test.
+pub(crate) fn probe_keeps(view_proj: Mat4, bounds: NodeBounds, discs: bool, dds: f32) -> bool {
+    squeezes_discs(discs, dds) || frustum_keeps(view_proj, bounds)
+}
+
+/// Probe (#1000): [`squeezes_discs`] for the probe.
+pub(crate) fn probe_squeezes(discs: bool, dds: f32) -> bool {
+    squeezes_discs(discs, dds)
+}
