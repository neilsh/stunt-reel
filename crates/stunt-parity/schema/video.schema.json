{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoCapture",
  "description": "Document written by the video capture harness as `meta.json`.\n\nFields the harness adds beyond these are ignored on read. Every field after `palettes` is\noptional, so a capture made before it was recorded still reads.",
  "type": "object",
  "properties": {
    "capture_start_frame": {
      "description": "Capture frame number of video frame 0.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "captured_on": {
      "description": "Date of the capture, `YYYY-MM-DD`.",
      "type": [
        "string",
        "null"
      ]
    },
    "checkout": {
      "description": "Name of the checkout the capture ran from.",
      "type": [
        "string",
        "null"
      ]
    },
    "cpu_profile": {
      "description": "CPU profile the emulator ran under.",
      "type": "string"
    },
    "dgroup_segment": {
      "description": "Runtime `DGROUP` segment as four upper-case hex digits.",
      "type": [
        "string",
        "null"
      ]
    },
    "emulator": {
      "description": "What recorded it.",
      "anyOf": [
        {
          "$ref": "#/$defs/EmulatorInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "end": {
      "description": "How the recording stopped.",
      "$ref": "#/$defs/CaptureEnd"
    },
    "film": {
      "description": "Film the capture shows.",
      "$ref": "#/$defs/FilmId"
    },
    "film_start_frame": {
      "description": "First logged frame at which the film clock moved.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "film_ticks": {
      "description": "First and last `film_tick` in the log.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "maxItems": 2,
      "minItems": 2
    },
    "geometry": {
      "description": "Raster geometry of the video.",
      "$ref": "#/$defs/Geometry"
    },
    "kind": {
      "description": "Document kind; always `\"video\"`. Absent in a frame capture's `meta.json`.",
      "type": "string",
      "default": ""
    },
    "layout": {
      "description": "The `DGROUP` offsets the log read.",
      "anyOf": [
        {
          "$ref": "#/$defs/LayoutOffsets"
        },
        {
          "type": "null"
        }
      ]
    },
    "log": {
      "description": "Per-frame clocks.",
      "$ref": "#/$defs/TickLog"
    },
    "palette_changes": {
      "description": "Number of entries in `palettes.changes`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "palettes": {
      "description": "Palette history.",
      "$ref": "#/$defs/PaletteLog"
    },
    "playone_build": {
      "description": "Build of `PLAYONE.EXE` that was recorded.",
      "type": "string"
    },
    "playone_sha256": {
      "description": "SHA-256 of the `PLAYONE.EXE` that was recorded; absent from captures made before the\nharness recorded it.",
      "type": [
        "string",
        "null"
      ]
    },
    "rows": {
      "description": "Number of rows in `log`.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "schema_version": {
      "description": "Schema version of the document.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sound_samples": {
      "description": "How the `.ALL`'s sound range was staged, `stubbed` or `kept` (ADR 0043).",
      "type": [
        "string",
        "null"
      ]
    },
    "video": {
      "description": "The recorded video beside this file.",
      "anyOf": [
        {
          "$ref": "#/$defs/VideoFileInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "video_frames": {
      "description": "Number of video frames the recording holds, which may differ from `rows` by one.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "film",
    "geometry",
    "playone_build",
    "cpu_profile",
    "capture_start_frame",
    "film_start_frame",
    "end",
    "log",
    "palettes"
  ],
  "$defs": {
    "CaptureEnd": {
      "description": "How the recording stopped.",
      "oneOf": [
        {
          "description": "The film ended and the harness held on its last frame.",
          "type": "string",
          "const": "hold"
        },
        {
          "description": "The harness stopped at its frame cap before the film ended.",
          "type": "string",
          "const": "capped"
        }
      ]
    },
    "EmulatorInfo": {
      "description": "The emulator that recorded the film, and the stage conf it ran under.",
      "type": "object",
      "properties": {
        "core": {
          "description": "`core` from the stage conf, such as `dynamic`.",
          "type": "string"
        },
        "cpu_cycles": {
          "description": "`cpu_cycles` from the stage conf, such as `45000` or `max`.",
          "type": "string"
        },
        "name": {
          "description": "Emulator name, such as `dosbox-automation`.",
          "type": "string"
        },
        "version": {
          "description": "Emulator version, such as `0.85.1`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "core",
        "cpu_cycles"
      ]
    },
    "FilmId": {
      "description": "Identity of the film an artifact was produced from: the bytes of its `.FLM` and archive.\n\nEvery field is optional because older captures and renders may lack it; two identities\nconflict on a field only when both carry it.",
      "type": "object",
      "properties": {
        "all_sha256": {
          "description": "SHA-256 of the `.ALL` as made, so a later `make-all` cannot hide which one was played.\nA capture records the unstubbed archive, not the sound-stubbed copy it plays (ADR 0043).",
          "type": [
            "string",
            "null"
          ]
        },
        "flm_bytes": {
          "description": "Length of the `.FLM` in bytes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "flm_sha256": {
          "description": "SHA-256 of the `.FLM`.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "File name of the `.FLM`, without a directory.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Geometry": {
      "description": "Raster geometry an artifact describes.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Height in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "viewport_rows": {
          "description": "Rows the 3D scene was drawn into when the render narrowed its viewport.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "description": "Width in pixels.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "LayoutOffsets": {
      "description": "The `DGROUP` offsets the log read, as `0x` and four upper-case hex digits.",
      "type": "object",
      "properties": {
        "film_clock": {
          "description": "Film clock word.",
          "type": "string"
        },
        "global_tick": {
          "description": "Game-wide tick counter word.",
          "type": "string"
        },
        "inferred": {
          "description": "Names of the offsets above that were inferred, not read from this build's code (ADR 0057).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slot_clock": {
          "description": "Slot pass clock word; present when the log carries `slot_clock`.",
          "type": [
            "string",
            "null"
          ]
        },
        "slot_ticks": {
          "description": "Ticks word of the slot pass; present when the log carries `slot_ticks`.",
          "type": [
            "string",
            "null"
          ]
        },
        "working_palette": {
          "description": "Working palette, 768 bytes.",
          "type": "string"
        }
      },
      "required": [
        "film_clock",
        "global_tick",
        "working_palette"
      ]
    },
    "PaletteChange": {
      "description": "A run of palette entries the game rewrote at one frame.",
      "type": "object",
      "properties": {
        "first": {
          "description": "Index of the first rewritten entry.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "frame": {
          "description": "Capture frame number at which the new entries took effect.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "rgb": {
          "description": "The rewritten entries, 8-bit RGB.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "maxItems": 3,
            "minItems": 3
          }
        }
      },
      "required": [
        "frame",
        "first",
        "rgb"
      ]
    },
    "PaletteLog": {
      "description": "The palette at the start of the log and every later write.",
      "type": "object",
      "properties": {
        "changes": {
          "description": "Palette writes in ascending frame order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PaletteChange"
          }
        },
        "initial": {
          "description": "The 256 entries in force at the first logged frame.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "maxItems": 3,
            "minItems": 3
          }
        }
      },
      "required": [
        "initial",
        "changes"
      ]
    },
    "TickLog": {
      "description": "Per-frame clocks, one entry per recorded video frame, as parallel columns.",
      "type": "object",
      "properties": {
        "film_tick": {
          "description": "Film clock the frame shows.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "frame": {
          "description": "Capture frame number of each row; ascends by one.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "global_tick": {
          "description": "Game-wide tick counter at the frame.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "slot_clock": {
          "description": "Clock of the slot pass at the frame (ADR 0057); present with\n`slot_ticks` or not at all.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          }
        },
        "slot_ticks": {
          "description": "Ticks since the previous slot pass at the frame; present with `slot_clock` or not at all.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          }
        }
      },
      "required": [
        "frame",
        "film_tick",
        "global_tick"
      ]
    },
    "VideoFileInfo": {
      "description": "The recorded video beside `meta.json`, as the emulator wrote it with audio stripped.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Length of the file in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "codec": {
          "description": "Video codec of the recording, such as `zmbv`.",
          "type": "string"
        },
        "file": {
          "description": "File name; always [`VIDEO_FILE`].",
          "type": "string"
        },
        "frame_rate": {
          "description": "Exact frame rate as numerator and denominator (`[2190197, 31250]`), which containers round.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "sha256": {
          "description": "SHA-256 of the file, which pins the recording.",
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256",
        "bytes",
        "codec",
        "frame_rate"
      ]
    }
  }
}
