#!/bin/sh
# Installed by `mise run init`, which points core.hooksPath at .githooks. The checks are
# `mise run pre-commit`, which runs prek over prek.toml; this file only dispatches them.
# They are a fast subset, not the gate: run `mise run check` before committing as usual.
# Skip once with `git commit --no-verify`.

# core.hooksPath turns off the untracked hooks in the git directory, so chain to one if present.
local_hook="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$local_hook" ]; then
    "$local_hook" "$@" || exit $?
fi

exec mise run pre-commit
