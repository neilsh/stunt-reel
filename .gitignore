/captures/
!tests/fixtures/parity/bench/capture/

# OS junk
Thumbs.db
.DS_Store

# Shared tool cache, one per primary checkout, named by absolute path from every worktree
# (ADR 0013, ADR 0033)
/.cache/

# Environment / local tool overrides
.mise.local.toml
mise.local.toml

# Antigravity teamwork runtime scratchpads & subagent workspaces
.agents/teamwork/
.agents/worktrees/

# Claude Code per-machine state (worktrees, personal settings)
.claude/worktrees/
.claude/settings.local.json
